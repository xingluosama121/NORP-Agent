<!DOCTYPE html>
<!--Copyright (c) 2026 xbm666,MIT Licensed-->
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NORP Agent</title>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<style>
/* NORP Agent 新前端样式
   Copyright (c) 2026 xbm666, MIT Licensed */
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#f6f7f9;--surface:#ffffff;--surface-2:#fafbfc;--surface-3:#f2f4f7;
  --border:#e6e8ec;--border-strong:#d5d9df;
  --text:#16181d;--text-2:#5f6672;--text-3:#9aa0ab;
  --accent:#007aff;--accent-hover:#0056d6;--accent-soft:#eaf3ff;--accent-soft-2:#f3f8ff;
  --green:#34c759;--green-soft:#e9f9ef;--red:#dc3545;--red-soft:#fdecee;--orange:#ff9500;--orange-soft:#fff4e5;
  --radius:10px;--radius-sm:7px;--radius-lg:14px;
  --shadow-sm:0 1px 2px rgba(16,24,40,.05);--shadow:0 4px 16px rgba(16,24,40,.07);--shadow-lg:0 14px 40px rgba(16,24,40,.14);
  --font:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;
  --mono:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
}
html,body{height:100%}
body{font-family:var(--font);background:var(--bg);color:var(--text);display:flex;flex-direction:column;overflow:hidden;-webkit-font-smoothing:antialiased;font-size:14px}
svg{display:block}
button{font-family:inherit;cursor:pointer}
input,textarea,select{font-family:inherit;color:var(--text)}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:4px}
::-webkit-scrollbar-track{background:transparent}
.hidden{display:none!important}

/* ═══ Loading ═══ */
#loading-overlay{position:fixed;inset:0;background:#f6f7f9;z-index:500;display:flex;align-items:center;justify-content:center}
#loading-overlay>div{text-align:center}
.loading-spinner{width:44px;height:44px;border-radius:50%;border:4px solid var(--accent-soft);border-top-color:var(--accent);margin:0 auto 18px;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
#loadingStatusText{font-size:13px;color:var(--text-2)}
.loading-fatal-badge{color:var(--red);font-weight:700;margin-left:8px}
.loading-progress{margin-top:10px;font-size:11px;color:var(--text-3)}
.loading-error-details{margin-top:10px;font-size:11px;color:var(--red);white-space:pre-wrap;max-width:520px}
.loading-exit-btn{margin-top:14px;padding:8px 20px;border-radius:8px;border:none;background:var(--red);color:#fff;font-size:13px}

/* ═══ Menu bar ═══ */
.menubar{height:34px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:2px;padding:0 10px;flex-shrink:0;user-select:none;font-size:12.5px}
.menubar .brand{display:flex;align-items:center;gap:7px;padding:0 8px 0 2px;font-weight:700;font-size:13px}
.menubar .brand .logo{width:20px;height:20px;border-radius:6px;background:linear-gradient(135deg,#007aff,#0056d6);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800}
.menubar .menu{display:flex;align-items:center;height:100%;gap:2px}
.menubar .menu-item{position:relative;padding:0 10px;height:100%;display:flex;align-items:center;border-radius:5px;color:var(--text-2);cursor:pointer}
.menubar .menu-item:hover{background:var(--surface-3);color:var(--text)}
.menubar .spacer{flex:1}
.menubar .win-ctrl{display:flex}
.menubar .win-ctrl span{width:40px;height:100%;display:flex;align-items:center;justify-content:center;color:var(--text-2);cursor:pointer;font-size:12px}
.menubar .win-ctrl span:hover{background:var(--surface-3)}
.menubar .win-ctrl .close:hover{background:#e81123;color:#fff}
.balance-chip{display:flex;align-items:center;gap:5px;height:24px;padding:0 11px;margin-right:6px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-size:12px;font-weight:700;cursor:pointer;transition:.15s}
.balance-chip:hover{background:var(--accent);color:#fff}
.balance-chip svg{width:13px;height:13px}
.menu-drop{position:absolute;top:100%;left:0;margin-top:2px;min-width:160px;background:var(--surface);border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow-lg);padding:5px;display:none;z-index:150}
.menu-drop.open{display:block}
.menu-drop .md-item{display:block;width:100%;text-align:left;padding:7px 11px;border:none;background:none;border-radius:7px;font-size:12.5px;color:var(--text);cursor:pointer}
.menu-drop .md-item:hover{background:var(--surface-3)}
.menu-drop .md-sep{height:1px;background:var(--border);margin:4px 6px}

/* ═══ Toolbar ═══ */
.toolbar{height:54px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;padding:0 14px;flex-shrink:0}
.search{flex:1;max-width:380px;height:34px;display:flex;align-items:center;gap:8px;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:0 12px;color:var(--text-3);transition:.15s}
.search:focus-within{border-color:var(--accent);background:var(--surface);box-shadow:0 0 0 3px var(--accent-soft)}
.search input{border:none;outline:none;background:transparent;flex:1;font-size:13px}
.search input::placeholder{color:var(--text-3)}
.toolbar .spacer{flex:1}
.btn{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 14px;border-radius:8px;border:1px solid var(--border);background:var(--surface);font-size:13px;font-weight:600;color:var(--text-2);transition:.15s}
.btn:hover{background:var(--surface-2);border-color:var(--border-strong)}
.btn svg{width:15px;height:15px}
.btn-primary{background:var(--accent);border-color:var(--accent);color:#fff;box-shadow:0 2px 8px rgba(0,122,255,.25)}
.btn-primary:hover{background:var(--accent-hover);border-color:var(--accent-hover)}
.btn-danger{background:var(--red);border-color:var(--red);color:#fff}
.btn-danger:hover{background:#a71d2a}
.btn-debug{background:#e9f9ef;border:1px solid #81d4af;color:#1b5e20}
.btn-debug:hover{background:#d7f0e2;border-color:#4caf50}
.debug-content{background:#0f1115;color:#d0d0d0;padding:12px;border-radius:8px;max-height:50vh;overflow:auto;white-space:pre-wrap;font-family:var(--mono);font-size:11.5px;line-height:1.6}
.db-row{display:flex;align-items:flex-start;gap:10px;padding:7px 4px;border-bottom:1px dashed var(--border)}
.db-row:last-child{border-bottom:none}
.db-label{flex-shrink:0;width:86px;font-size:12px;font-weight:600;color:var(--text-2)}
.db-value{flex:1;font-size:12.5px;color:var(--text);word-break:break-all}
.db-count{display:inline-block;min-width:18px;padding:0 5px;border-radius:6px;background:var(--accent-soft);color:var(--accent);font-size:10.5px;font-weight:700;text-align:center}
.flow-placeholder{border-style:dashed;color:var(--text-3);font-weight:600}
.flow-placeholder:hover{border-color:var(--border-strong);background:var(--surface-2);color:var(--text-3);cursor:not-allowed}
.flow-placeholder .soon{font-size:9.5px;font-weight:700;color:var(--text-3);background:var(--surface-3);padding:1px 7px;border-radius:999px;margin-left:2px}
.flow-btn{border-color:#00b8d4;color:#0091a8}
.flow-btn:hover{border-color:#00b8d4;background:#e6fafc;color:#00707f}

/* ═══ 模块流程编排 FLOW 浮层 ═══ */
#flow-overlay{position:fixed;inset:0;z-index:200;background:#04060f;display:none;flex-direction:column}
#flow-overlay.open{display:flex}
#flow-overlay .fo-head{height:40px;display:flex;align-items:center;gap:10px;padding:0 14px;background:#0a1120;border-bottom:1px solid #1c2b44;flex-shrink:0}
#flow-overlay .fo-title{color:#00e5ff;font-size:13px;font-weight:600;letter-spacing:1px;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#flow-overlay .fo-head button{background:#132238;color:#cfe6ff;border:1px solid #1c2b44;border-radius:6px;padding:4px 12px;font-size:12px;cursor:pointer;transition:.15s}
#flow-overlay .fo-head button:hover{background:#1c3a5f}
#flow-overlay #flow-frame{flex:1;border:0;width:100%;height:100%;background:#04060f}

/* ═══ App layout ═══ */
.app{flex:1;display:flex;min-height:0}

/* Rail（折叠态，悬停展开） */
.rail-wrap{flex-shrink:0}
.rail{width:60px;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;align-items:center;padding:12px 6px;gap:2px;flex-shrink:0;overflow:hidden;white-space:nowrap;transition:width .22s cubic-bezier(.2,.8,.25,1)}
.rail-wrap:hover .rail{width:202px;align-items:stretch;padding:12px 8px}
.rail-brand{display:flex;align-items:center;gap:9px;width:100%;height:38px;margin-bottom:12px;justify-content:center}
.rail-wrap:hover .rail-brand{justify-content:flex-start;padding:0 4px}
.rail-logo{width:36px;height:36px;border-radius:10px;flex-shrink:0;background:linear-gradient(135deg,#007aff,#0056d6);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;box-shadow:0 4px 12px rgba(0,122,255,.32)}
.rail-name{font-size:13px;font-weight:700;display:none}
.rail-wrap:hover .rail-name{display:inline-block;animation:labelIn .16s ease}
.rail .rail-item{width:100%;height:40px;border-radius:9px;display:flex;align-items:center;justify-content:center;gap:10px;padding:0;position:relative;transition:.13s;border:none;background:transparent;color:var(--text-3);flex-shrink:0}
.rail .rail-item svg{width:20px;height:20px;flex-shrink:0}
.rail-wrap:hover .rail .rail-item{justify-content:flex-start;padding:0 13px}
.rail .rail-item:hover{background:var(--surface-3);color:var(--text-2)}
.rail .rail-item.active{background:var(--accent-soft);color:var(--accent)}
.rail .rail-item span{display:none}
.rail-wrap:hover .rail .rail-item span:not(.badge){display:inline-block;animation:labelIn .16s ease}
@keyframes labelIn{from{opacity:0;transform:translateX(-4px)}to{opacity:1;transform:none}}
.rail-spacer{flex:1}
.rail .avatar{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#7dd3fc,#007aff);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0}

/* 进程栏（折叠态，悬停展开） */
.panel-wrap{flex-shrink:0}
.panel{width:56px;background:var(--surface-2);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;min-height:0;overflow:hidden;transition:width .22s cubic-bezier(.2,.8,.25,1)}
.panel-wrap:hover .panel{width:272px}
.panel-collapsed{width:56px;display:flex;flex-direction:column;align-items:center;padding:14px 0;gap:10px;flex:1}
.panel-collapsed .pc-icon{width:38px;height:38px;border-radius:11px;background:var(--surface-3);color:var(--text-2);display:flex;align-items:center;justify-content:center;font-size:16px}
.panel-collapsed .pc-count{min-width:22px;height:18px;padding:0 6px;border-radius:9px;background:var(--accent-soft);color:var(--accent);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center}
.panel-collapsed .pc-label{writing-mode:vertical-rl;font-size:10px;color:var(--text-3);letter-spacing:2px}
.panel-collapsed .pc-spacer{flex:1}
.panel-collapsed .pc-dot{width:8px;height:8px;border-radius:2px;background:var(--green);margin-bottom:12px}
.panel-expanded{display:none;flex:1;min-height:0;flex-direction:column;width:272px}
.panel-wrap:hover .panel-expanded{display:flex;animation:fadeIn .15s ease}
.panel-wrap:hover .panel-collapsed{display:none}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.panel-head{padding:14px 14px 10px;display:flex;align-items:center;justify-content:space-between}
.panel-head h2{font-size:13px;font-weight:700;color:var(--text-2)}
.panel-head .count{font-size:11px;color:var(--text-3)}
.panel-list{flex:1;overflow-y:auto;padding:2px 12px 12px;display:flex;flex-direction:column;gap:10px}
.island{position:relative;display:flex;align-items:center;gap:11px;height:46px;padding:0 15px;border-radius:999px;background:#0d1117;color:#fff;cursor:pointer;user-select:none;flex-shrink:0;transition:transform .18s cubic-bezier(.2,.8,.25,1),box-shadow .18s,opacity .18s;box-shadow:0 4px 14px rgba(13,17,23,.16)}
.island:hover{transform:scale(1.03);box-shadow:0 8px 22px rgba(13,17,23,.24)}
.island.active{box-shadow:0 0 0 2px rgba(0,122,255,.55),0 8px 22px rgba(13,17,23,.22)}
.island.running{background:linear-gradient(135deg,#0d1117 0%,#141b26 100%)}
.island.running::after{content:"";position:absolute;inset:-1px;border-radius:999px;border:1.5px solid rgba(0,122,255,.6);animation:islandPulse 2.2s ease-in-out infinite;pointer-events:none}
@keyframes islandPulse{0%,100%{opacity:.45}50%{opacity:1}}
.island .is-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.island.running .is-dot{background:#4da3ff;box-shadow:0 0 0 4px rgba(77,163,255,.22),0 0 12px rgba(77,163,255,.75)}
.island.done .is-dot{background:#34c759;box-shadow:0 0 0 4px rgba(52,199,89,.18)}
.island.idle .is-dot{background:#8b949e}
.island .is-title{flex:1;font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.island .is-tag{font-size:10px;font-weight:600;color:#9aa0ab;background:rgba(255,255,255,.09);padding:2px 9px;border-radius:999px;flex-shrink:0}
.island.running .is-tag{color:#8ecbff;background:rgba(77,163,255,.16)}
.panel-foot{padding:10px 12px;border-top:1px solid var(--border);display:flex;align-items:center;gap:8px}
.workspace{flex:1;height:32px;display:flex;align-items:center;gap:8px;padding:0 10px;border:1px solid var(--border);border-radius:7px;background:var(--surface);font-size:12px;color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.workspace .w-dot{width:7px;height:7px;border-radius:2px;background:var(--green);flex-shrink:0}
.workspace svg{width:13px;height:13px;color:var(--text-3);margin-left:auto;flex-shrink:0}

/* ═══ Main ═══ */
.main{flex:1;display:flex;flex-direction:column;min-width:0;background:var(--surface)}
.view{flex:1;display:flex;flex-direction:column;min-height:0}
.page{flex:1;display:flex;flex-direction:column;min-height:0;animation:fadeIn .18s ease}
.page-head{padding:16px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;flex-shrink:0}
.page-head h2{font-size:16px;font-weight:700}
.page-head .sub{font-size:12px;color:var(--text-3)}
.page-head .spacer{flex:1}
.page-body{flex:1;overflow-y:auto;padding:20px 24px}

/* Home */
.home{flex:1;overflow-y:auto;display:flex;flex-direction:column;align-items:center;padding:52px 40px 30px}
.home .hero{text-align:center;margin-bottom:30px;position:relative}
.home .hero .glow{position:absolute;top:-80px;left:50%;transform:translateX(-50%);width:460px;height:460px;border-radius:50%;pointer-events:none;background:radial-gradient(circle,rgba(0,122,255,.13) 0%,rgba(0,122,255,.045) 42%,transparent 70%)}
.norp-logo{position:relative;width:88px;height:88px;border-radius:26px;margin:0 auto 22px;background:linear-gradient(135deg,#0a84ff 0%,#007aff 45%,#0044b8 100%);color:#fff;display:flex;align-items:center;justify-content:center;font-size:46px;font-weight:800;line-height:1;box-shadow:0 20px 44px rgba(0,90,220,.38),inset 0 1px 0 rgba(255,255,255,.28);animation:logoFloat 5s ease-in-out infinite}
.norp-logo::after{content:"";position:absolute;inset:-7px;border-radius:32px;border:1.5px solid rgba(0,122,255,.28);pointer-events:none}
.norp-logo .logo-shine{position:absolute;top:10%;left:12%;width:26%;height:22%;border-radius:50%;background:rgba(255,255,255,.55);filter:blur(3px);pointer-events:none}
@keyframes logoFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.home .hero .kicker{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--accent);background:var(--accent-soft);padding:5px 12px;border-radius:20px;margin-bottom:16px}
.home .hero h1{font-size:32px;font-weight:800;letter-spacing:-.6px;margin-bottom:10px;background:linear-gradient(120deg,#16181d,#3a4351);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.home .hero p{font-size:14px;color:var(--text-2)}
.hero-input{width:100%;max-width:680px;border:1.5px solid var(--border-strong);border-radius:18px;background:var(--surface);box-shadow:var(--shadow);overflow:hidden;transition:.15s}
.hero-input:focus-within{border-color:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}
.hero-tools{display:flex;align-items:center;gap:6px;padding:12px 14px 2px;flex-wrap:wrap}
.hi-input{width:100%;border:none;outline:none;resize:none;padding:14px 20px 8px;font-size:15px;line-height:1.7;font-family:inherit;background:transparent;min-height:66px}
.hi-input::placeholder{color:var(--text-3)}
.hi-foot{display:flex;align-items:center;gap:10px;padding:8px 14px 14px}
.hi-hint{font-size:11px;color:var(--text-3)}
.pick{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:7px;border:1px solid var(--border);background:var(--surface-2);font-size:12px;font-weight:600;color:var(--text-2);transition:.13s}
.pick:hover{border-color:var(--border-strong);background:var(--surface)}
.pick svg{width:13px;height:13px}
.pick.dim{color:var(--text-3);font-weight:500}

/* ═══ 输入框选择器 popover（模式 / 模型） ═══ */
.pick-pop{position:fixed;z-index:320;min-width:260px;max-width:340px;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);padding:6px;display:flex;flex-direction:column;max-height:64vh}
.pp-head{display:flex;align-items:center;gap:8px;padding:7px 10px;font-size:12px;font-weight:700;color:var(--text)}
.pp-sub{font-size:10.5px;font-weight:500;color:var(--text-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.pp-list{overflow-y:auto;flex:1;min-height:40px}
.pp-item{padding:8px 10px;border-radius:8px;cursor:pointer;font-size:12.5px;color:var(--text)}
.pp-item:hover{background:var(--surface-3)}
.pp-item.active{background:var(--accent-soft);color:var(--accent);font-weight:700}
.pp-item.active:hover{background:var(--accent-soft)}
.ppi-top{display:flex;align-items:center;gap:6px}
.ppi-top b{font-size:12.5px}
.ppi-desc{margin-top:2px;font-size:11px;color:var(--text-3);line-height:1.5;word-break:break-all}
.pp-item.active .ppi-desc{color:var(--accent)}
.pp-empty{padding:18px 12px;text-align:center;font-size:12px;color:var(--text-3)}
.pp-loading{padding:16px 12px;text-align:center;font-size:12px;color:var(--text-3)}
.pp-foot{display:flex;gap:6px;padding:7px 6px 5px;border-top:1px solid var(--border);margin-top:4px}
.pp-btn{flex:1;height:28px;border-radius:7px;border:1px solid var(--border);background:var(--surface-2);font-size:11.5px;font-weight:600;color:var(--text-2);cursor:pointer;transition:.13s}
.pp-btn:hover{background:var(--surface-3);border-color:var(--border-strong)}
.send{height:34px;padding:0 16px;border-radius:8px;border:none;background:var(--accent);color:#fff;font-size:13px;font-weight:700;display:inline-flex;align-items:center;gap:7px;transition:.15s;box-shadow:0 2px 8px rgba(0,122,255,.25)}
.send:hover{background:var(--accent-hover)}
.send svg{width:15px;height:15px}

/* Chat */
.chat-top{padding:12px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-shrink:0}
.chat-top h3{font-size:14px;font-weight:700;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-top .pill{font-size:11px;font-weight:600;padding:3px 9px;border-radius:6px;background:var(--accent-soft);color:var(--accent);flex-shrink:0}
.chat-top .pill.done{background:var(--green-soft);color:#1e8e3e}
.chat-top .icon-btn{width:30px;height:30px;border-radius:7px;border:1px solid var(--border);background:var(--surface);display:flex;align-items:center;justify-content:center;color:var(--text-2);transition:.13s}
.chat-top .icon-btn:hover{background:var(--surface-2);border-color:var(--border-strong)}
.chat-top .icon-btn svg{width:15px;height:15px}
.seg{display:flex;gap:2px;background:var(--surface-3);padding:3px;border-radius:8px;flex-shrink:0}
.seg-btn{border:none;background:transparent;padding:5px 13px;border-radius:6px;font-size:12px;font-weight:600;color:var(--text-3);cursor:pointer;transition:.13s}
.seg-btn:hover{color:var(--text-2)}
.seg-btn.active{background:var(--surface);color:var(--text);box-shadow:var(--shadow-sm)}
.chat-scroll{flex:1;overflow:visible;padding:24px 0}
.chat-inner{max-width:820px;margin:0 auto;padding:0 24px;display:flex;flex-direction:column;gap:18px}
.msg{display:flex;gap:12px}
.msg .m-avatar{width:30px;height:30px;border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}
.msg.user .m-avatar{background:linear-gradient(135deg,#7dd3fc,#007aff);color:#fff}
.msg.assistant .m-avatar{background:linear-gradient(135deg,#007aff,#0056d6);color:#fff}
.msg .m-body{flex:1;min-width:0}
.msg .m-meta{font-size:11px;color:var(--text-3);margin-bottom:5px;display:flex;align-items:center;gap:8px}
.msg .m-meta b{color:var(--text-2);font-weight:600}
.msg.user .m-bubble{background:var(--accent);color:#fff;padding:10px 14px;border-radius:12px 12px 3px 12px;font-size:13.5px;line-height:1.6;display:inline-block;max-width:100%;white-space:pre-wrap;word-break:break-word}
.msg.assistant .m-bubble{color:var(--text);font-size:13.5px;line-height:1.7;word-break:break-word}
.msg.assistant .m-bubble p{margin:0 0 8px}
.msg.assistant .m-bubble p:last-child{margin-bottom:0}
.msg.assistant .m-bubble ul,.msg.assistant .m-bubble ol{margin:4px 0 10px;padding-left:20px}
.msg.assistant .m-bubble li{margin:3px 0}
.msg.assistant .m-bubble code{font-family:var(--mono);font-size:12px;background:var(--surface-3);padding:1px 5px;border-radius:4px}
.msg.assistant .m-bubble pre{background:#0f1115;color:#d7dae0;padding:12px 14px;border-radius:8px;overflow-x:auto;font-family:var(--mono);font-size:12.5px;line-height:1.6;margin:8px 0}
.msg.assistant .m-bubble pre code{background:none;padding:0;font-size:12.5px}
.msg.assistant .m-bubble table{border-collapse:collapse;margin:8px 0;font-size:12.5px}
.msg.assistant .m-bubble th,.msg.assistant .m-bubble td{border:1px solid var(--border);padding:6px 10px}
.msg.assistant .m-bubble th{background:var(--surface-3)}
.msg.assistant .m-bubble blockquote{border-left:3px solid var(--border-strong);padding:2px 12px;color:var(--text-2);margin:8px 0}
.thinking-box{border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface-2);font-size:12px;color:var(--text-3);margin-bottom:8px;padding:0;overflow:hidden;white-space:pre-wrap;line-height:1.6;transition:max-height .2s ease}
.thinking-box.collapsed .th-body{display:none}
.thinking-box .th-title{font-weight:700;color:var(--text-2);margin:0;padding:8px 12px;cursor:pointer;display:flex;align-items:center;gap:6px;user-select:none;transition:.13s}
.thinking-box .th-title:hover{background:var(--surface-3)}
.thinking-box .th-title .th-chevron{width:10px;height:10px;transition:.15s;flex-shrink:0}
.thinking-box.collapsed .th-title .th-chevron{transform:rotate(-90deg)}
.thinking-box .th-body{padding:0 12px 10px;overflow:hidden}
.typing{display:inline-flex;gap:4px;padding:12px 16px;background:var(--surface-2);border:1px solid var(--border);border-radius:14px 14px 14px 3px}
.typing i{width:6px;height:6px;border-radius:50%;background:var(--text-3);animation:blink 1.2s infinite}
.typing i:nth-child(2){animation-delay:.2s}
.typing i:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,80%,100%{opacity:.25}40%{opacity:1}}

/* 命令轨迹 */
.traj-view{flex:1;display:flex;flex-direction:column;min-height:0;overflow:visible;padding:20px 24px}
.traj-view-head{display:flex;align-items:center;gap:10px;margin:0 auto 16px;font-size:12.5px;color:var(--text-3);max-width:860px;width:100%}
.traj-view-head b{color:var(--text)}
.traj-view-head .tv-tag{font-size:10.5px;font-weight:600;background:var(--accent-soft);color:var(--accent);padding:2px 8px;border-radius:999px}
.traj-view-body{max-width:860px;margin:0 auto;width:100%}
.cmd-log{background:#fafafa;border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;font-family:var(--mono);font-size:11.5px;line-height:1.6;white-space:pre-wrap;word-break:break-word}
.cmd-entry{margin-bottom:13px;padding-bottom:11px;border-bottom:1px dashed var(--border)}
.cmd-entry:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0}
.cmd-entry .cmd-tool{color:#e08f3a;font-weight:700;font-size:12px}
.cmd-entry .cmd-tool::before{content:"▶ "}
.cmd-entry .cmd-args{color:var(--text-2);padding-left:16px;margin-top:2px}
.cmd-entry .cmd-args .k{color:var(--accent)}
.cmd-entry .cmd-out{margin-top:6px;padding:8px 12px;background:#f0f2f5;border-radius:6px;color:#3a4351;font-size:11px;white-space:pre-wrap;word-break:break-word}
.cmd-entry .cmd-status{font-size:10.5px;font-weight:700;margin-top:5px;padding-left:16px}
.cmd-entry.done .cmd-status{color:#1e8e3e}
.cmd-entry.running .cmd-status{color:var(--accent)}
.cmd-empty{padding:60px 20px;text-align:center;color:var(--text-3);font-family:var(--font)}

/* Input */
.input-wrap{padding:12px 20px 16px;flex-shrink:0}
.input-box{max-width:820px;margin:0 auto;border:1px solid var(--border-strong);border-radius:var(--radius-lg);background:var(--surface);box-shadow:var(--shadow);overflow:hidden;transition:.15s}
.input-box:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.input-tools{display:flex;align-items:center;gap:6px;padding:10px 12px 4px;flex-wrap:wrap}
.input-tools .right{margin-left:auto;display:flex;align-items:center;gap:6px}
.btn-settings{width:28px;height:28px;border-radius:6px;border:none;background:transparent;color:var(--text-3);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.13s;font-size:15px;flex-shrink:0}
.btn-settings:hover{background:var(--surface-3);color:var(--text-2)}
textarea.in{width:100%;border:none;outline:none;resize:none;padding:10px 14px 12px;font-size:14px;line-height:1.6;min-height:52px;max-height:200px;background:transparent}
textarea.in::placeholder{color:var(--text-3)}
.input-foot{display:flex;align-items:center;gap:10px;padding:8px 12px 12px}
.ctx-bar{display:flex;align-items:center;gap:8px;font-size:10.5px;color:var(--text-3);flex-shrink:0}
.ctx-track{width:84px;height:5px;border-radius:3px;background:var(--surface-3);overflow:hidden}
.ctx-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,#34c759,#ff9500);transition:width .5s}

/* ═══ 右侧文件面板 ═══ */
.right-side{display:flex;flex-shrink:0}
.right-panel{width:0;overflow:hidden;background:var(--surface);border-left:1px solid var(--border);display:flex;flex-direction:column;transition:width .22s cubic-bezier(.2,.8,.25,1);min-height:0}
.right-side.open .right-panel{width:304px}
.rp-tabs{display:flex;gap:2px;padding:8px 10px 0;border-bottom:1px solid var(--border);flex-shrink:0}
.rp-tab{border:none;background:transparent;padding:8px 13px;font-size:12.5px;font-weight:600;color:var(--text-3);border-bottom:2px solid transparent;transition:.13s;cursor:pointer;display:flex;align-items:center;gap:6px}
.rp-tab:hover{color:var(--text-2)}
.rp-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.rp-body{flex:1;overflow:hidden;display:flex;flex-direction:column;min-height:0}
.rp-search{display:flex;align-items:center;gap:7px;padding:10px 12px;border-bottom:1px solid var(--border);color:var(--text-3)}
.rp-search input{flex:1;border:1px solid var(--border);background:var(--surface-2);border-radius:7px;height:30px;padding:0 10px;font-size:12.5px;outline:none;transition:.13s}
.rp-search input:focus{border-color:var(--accent);background:var(--surface)}
.rp-tree{flex:1;overflow-y:auto;padding:8px 6px}
.rp-folder{font-size:12.5px;color:var(--text-2);padding:6px 8px;border-radius:6px;cursor:pointer;display:flex;align-items:center;gap:7px;font-weight:600;user-select:none}
.rp-folder:hover{background:var(--surface-3)}
.rp-folder .chev{width:12px;height:12px;transition:.15s;flex-shrink:0;color:var(--text-3)}
.rp-folder.open .chev{transform:rotate(90deg)}
.rp-children{margin-left:15px;border-left:1px solid var(--border);padding-left:4px;display:none}
.rp-folder.open + .rp-children{display:block}
.rp-file{font-size:12.5px;color:var(--text-2);padding:5px 8px;border-radius:6px;cursor:pointer;display:flex;align-items:center;gap:7px;user-select:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rp-file:hover{background:var(--surface-3);color:var(--text)}
.rp-file .f-ico{font-size:13px;width:16px;text-align:center;flex-shrink:0}
.rp-prev{flex:1;display:flex;flex-direction:column;min-height:0}
.rp-prev-head{display:flex;align-items:center;gap:8px;padding:9px 12px;border-bottom:1px solid var(--border);font-size:12.5px;font-weight:600;flex-shrink:0}
.rp-prev-head .rp-prev-title{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rp-prev-head .rp-x{border:none;background:transparent;color:var(--text-3);font-size:13px;cursor:pointer;padding:2px 6px;border-radius:5px}
.rp-prev-head .rp-x:hover{background:var(--surface-3);color:var(--text)}
.rp-prev-body{flex:1;overflow:auto;padding:12px 14px;font-family:var(--mono);font-size:12px;line-height:1.7;white-space:pre-wrap;word-break:break-word}
.right-rail{width:44px;background:var(--surface);border-left:1px solid var(--border);display:flex;flex-direction:column;align-items:center;padding:10px 0;gap:6px;flex-shrink:0}
.rr-btn{width:34px;height:34px;border-radius:9px;border:none;background:transparent;color:var(--text-3);display:flex;align-items:center;justify-content:center;transition:.15s;cursor:pointer}
.rr-btn:hover{background:var(--surface-3);color:var(--text-2)}
.rr-btn svg{width:18px;height:18px}
.right-side.open .rr-btn{color:var(--accent);background:var(--accent-soft)}

/* ═══ 状态栏 ═══ */
.statusbar{height:26px;background:var(--surface);border-top:1px solid var(--border);display:flex;align-items:center;gap:16px;padding:0 14px;font-size:11px;color:var(--text-3);flex-shrink:0;overflow:hidden;white-space:nowrap}
.statusbar .s-right{margin-left:auto;display:flex;gap:14px}
.statusbar .dot-live{width:7px;height:7px;border-radius:50%;background:var(--green);display:inline-block;margin-right:5px}
.statusbar .tok{color:var(--text-2)}
.statusbar .tok b{color:var(--accent);font-weight:600}
#status-workspace{overflow:hidden;text-overflow:ellipsis;max-width:40%}

/* ═══ Modal ═══ */
.modal-overlay{position:fixed;inset:0;background:rgba(16,24,40,.4);backdrop-filter:blur(2px);display:none;align-items:flex-start;justify-content:center;padding:60px 20px;z-index:100}
.modal-overlay.open{display:flex;animation:fadeIn .16s ease}
.modal-card{width:100%;max-width:640px;max-height:82vh;background:var(--surface);border-radius:16px;box-shadow:var(--shadow-lg);display:flex;flex-direction:column;overflow:hidden}
.modal-head{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-shrink:0}
.modal-head h2{font-size:15px;font-weight:700;flex:1}
.modal-head .x-btn{width:28px;height:28px;border-radius:7px;border:none;background:transparent;color:var(--text-3);font-size:14px;transition:.13s}
.modal-head .x-btn:hover{background:var(--surface-3);color:var(--text)}
.modal-body{flex:1;overflow-y:auto;padding:8px 20px 16px}
.modal-foot{padding:12px 20px;border-top:1px solid var(--border);display:flex;align-items:center;gap:8px;flex-shrink:0}
.modal-foot .spacer{flex:1}
.set-section{border-bottom:1px solid var(--border);padding:14px 0}
.set-section:last-child{border-bottom:none}
.set-section h3{font-size:12px;font-weight:700;color:var(--text-3);letter-spacing:.4px;margin-bottom:10px}
.field{margin-bottom:10px}
.field:last-child{margin-bottom:0}
.field label{display:block;font-size:12px;color:var(--text-2);margin-bottom:4px}
.field input[type=text],.field input[type=password],.field input[type=number],.field select{width:100%;height:32px;border:1px solid var(--border);border-radius:7px;background:var(--surface-2);padding:0 10px;font-size:13px;outline:none;transition:.13s}
.field input:focus,.field select:focus{border-color:var(--accent);background:var(--surface);box-shadow:0 0 0 3px var(--accent-soft)}
.field .row{display:flex;gap:8px;align-items:center}
.check-line{display:flex;align-items:center;gap:9px;padding:3px 0;font-size:13px}
.check-line input{accent-color:var(--accent);width:15px;height:15px}
.slider-row{display:flex;align-items:center;gap:10px}
.slider-row input[type=range]{flex:1;accent-color:var(--accent)}
.slider-val{font-size:12px;font-weight:700;color:var(--accent);min-width:30px;text-align:right}
.hint-text{font-size:11px;color:var(--text-3);margin-top:3px;line-height:1.5}
.ssh-box{padding:4px 2px}
.ssh-row{display:flex;gap:6px;align-items:center}
.ssh-host-list{margin-top:10px;max-height:180px;overflow:auto;display:flex;flex-direction:column;gap:4px}
.ssh-host-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;font-size:12.5px;cursor:pointer;transition:.13s}
.ssh-host-item:hover{border-color:var(--border-strong);background:var(--surface-2)}
.ssh-host-item .hh-alias{font-weight:600}
.ssh-host-item .hh-host{color:var(--text-3);font-size:11px;margin-left:auto}
.ssh-output{background:#0f1115;color:#d0d0d0;padding:10px;border-radius:8px;max-height:200px;overflow:auto;white-space:pre-wrap;font-size:12px;margin-top:8px;font-family:var(--mono)}
.remote-body{font-size:13px;line-height:1.8;color:var(--text-2)}
.remote-body .rb-row{display:flex;align-items:center;gap:8px;margin:8px 0}

/* ═══ Toast ═══ */
.toasts{position:fixed;bottom:44px;left:50%;transform:translateX(-50%);z-index:300;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none}
.toast{background:#16181d;color:#fff;font-size:12.5px;padding:9px 18px;border-radius:999px;box-shadow:var(--shadow-lg);opacity:0;transform:translateY(8px) scale(.97);transition:.25s;max-width:80vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.toast.show{opacity:1;transform:none}

/* ═══ 页面内容（技能/插件/消息）═══ */
.skill-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.skill-card{padding:16px;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);display:flex;flex-direction:column;gap:10px;transition:.15s}
.skill-card:hover{border-color:var(--border-strong);box-shadow:var(--shadow)}
.skill-card .sk-top{display:flex;align-items:center;gap:10px}
.skill-card .sk-icon{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;background:var(--accent-soft-2)}
.skill-card .sk-name{font-size:13.5px;font-weight:600;flex:1}
.skill-card .sk-desc{font-size:12px;color:var(--text-3);line-height:1.5}
.plugin-list{display:flex;flex-direction:column;gap:8px}
.plugin-item{display:flex;align-items:center;gap:12px;padding:14px 16px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);transition:.15s}
.plugin-item .pl-icon{width:36px;height:36px;border-radius:10px;background:var(--surface-3);display:flex;align-items:center;justify-content:center;font-size:17px}
.plugin-item .pl-body{flex:1;min-width:0}
.plugin-item .pl-name{font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:8px}
.plugin-item .pl-ver{font-size:11px;color:var(--text-3);font-weight:400}
.plugin-item .pl-desc{font-size:12px;color:var(--text-3);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.plugin-item .pl-meta{display:flex;gap:6px;margin-top:4px}
.tag-mini{font-size:10px;padding:1px 6px;border-radius:4px;font-weight:600}
.tag-blue{background:var(--accent-soft);color:var(--accent)}
.tag-green{background:var(--green-soft);color:#1e8e3e}
.tag-orange{background:var(--orange-soft);color:var(--orange)}
.msg-list{display:flex;flex-direction:column;gap:6px}
.mc-item{display:flex;gap:12px;padding:12px 14px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);transition:.13s}
.mc-item .mc-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;background:var(--surface-3)}
.mc-item .mc-body{flex:1;min-width:0}
.mc-item .mc-title{font-size:13px;font-weight:600}
.mc-item .mc-detail{font-size:12px;color:var(--text-3);margin-top:2px;line-height:1.5}
.mc-item .mc-time{font-size:11px;color:var(--text-3);flex-shrink:0}
.empty{padding:60px 20px;text-align:center;color:var(--text-3)}
.empty .e-icon{font-size:38px;margin-bottom:12px;opacity:.7}
.empty p{font-size:13px;line-height:1.7}
.pp-dir{display:flex;align-items:center;gap:8px;padding:7px 10px;border:1px solid var(--border);border-radius:8px;font-size:12.5px;margin-bottom:6px}
.pp-dir .pd-path{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--mono);font-size:11.5px}
.pp-dir .pd-x{border:none;background:transparent;color:var(--text-3);cursor:pointer;font-size:12px;padding:2px 6px;border-radius:5px}
.pp-dir .pd-x:hover{background:var(--red-soft);color:var(--red)}
.pp-plugin{display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:12.5px;border-bottom:1px dashed var(--border)}
.pp-plugin .pp-name{font-weight:600}
.pp-plugin .pp-ver{color:var(--text-3);font-size:11px}
.pp-plugin .pp-tools{margin-left:auto;font-size:11px;color:var(--text-3)}
.pp-plugin .pp-err{color:var(--red);font-size:11px}

</style>
</head>
<body>

<!-- ═════════ Loading ═════════ -->
<div id="loading-overlay">
  <div>
    <div class="loading-spinner"></div>
    <p><span id="loadingStatusText">加载中...</span><span class="loading-fatal-badge" id="loadingFatalBadge"></span></p>
    <div class="loading-progress" id="loadingProgress"></div>
    <div class="loading-error-details" id="loadingErrorDetails"></div>
    <button class="loading-exit-btn" id="loadingExitBtn" style="display:none;" onclick="if(window.pywebview&&window.pywebview.api)window.pywebview.api.quit_app();else window.close();">退出程序</button>
  </div>
</div>

<!-- ═════════ Menu Bar ═════════ -->
<div class="menubar">
  <div class="brand"><span class="logo">N</span>NORP Agent</div>
  <nav class="menu">
    <div class="menu-item" data-menu="help">帮助</div>
  </nav>
  <div class="spacer"></div>
  <div class="balance-chip" id="balance-chip">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 8.5h8M8 12h8M8 15.5h5"/></svg>
    <span id="balance-val">—</span>
  </div>
</div>

<!-- ═════════ Toolbar ═════════ -->
<div class="toolbar">
  <div class="search">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="text" placeholder="搜索任务…" id="search-input">
  </div>
  <div class="spacer"></div>
  <button class="btn flow-btn" id="flow-btn">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h10M4 17h7"/></svg>
    🧩 流程编排
  </button>
  <button class="btn btn-primary" id="btn-new-task">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
    新建任务
  </button>
</div>

<!-- ═════════ App ═════════ -->
<div class="app">

  <!-- 左侧图标栏（折叠态，悬停展开） -->
  <div class="rail-wrap">
    <div class="rail">
      <div class="rail-brand">
        <span class="rail-logo">N</span>
        <span class="rail-name">NORP Agent</span>
      </div>
      <button class="rail-item active" data-nav="process" title="进程">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 2 7l10 5 10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        <span>进程</span>
      </button>
      <button class="rail-item" data-nav="skills" title="技能">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.9 2.4L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/></svg>
        <span>技能</span>
      </button>
      <button class="rail-item" data-nav="plugins" title="插件">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 4a2 2 0 0 1 4 0v1a2 2 0 0 0 2 2h1a2 2 0 0 1 0 4h-1a2 2 0 0 0-2 2v1a2 2 0 0 1-4 0v-1a2 2 0 0 0-2-2H7a2 2 0 0 1 0-4h1a2 2 0 0 0 2-2z"/></svg>
        <span>插件</span>
      </button>
      <button class="rail-item" data-nav="automation" title="自动化">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
        <span>自动化</span>
      </button>
      <button class="rail-item" data-nav="messages" title="消息">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span>消息</span>
      </button>
      <button class="rail-item" data-nav="recovery" title="回退">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        <span>回退</span>
      </button>
      <button class="rail-item" id="ssh-btn" data-nav="ssh" style="display:none;" title="SSH">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h.01M11 9h.01M15 9h.01M7 13h.01M11 13h.01M15 13h.01M7 17h8"/></svg>
        <span>SSH</span>
      </button>
      <button class="rail-item" id="remote-btn" data-nav="remote" style="display:none;" title="移动端">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>
        <span>移动端</span>
      </button>
      <div class="rail-spacer"></div>
      <button class="rail-item" data-nav="settings" title="设置">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3h0a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5h0a1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9v0a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
        <span>设置</span>
      </button>
      <div class="avatar">N</div>
    </div>
  </div>

  <!-- 进程栏（折叠态，悬停展开） -->
  <div class="panel-wrap">
    <div class="panel">
      <div class="panel-collapsed">
        <div class="pc-icon">⧉</div>
        <div class="pc-count" id="pc-count">0</div>
        <div class="pc-label">进程</div>
        <div class="pc-spacer"></div>
        <div class="pc-dot"></div>
      </div>
      <div class="panel-expanded">
        <div class="panel-head">
          <h2>进程</h2><span class="count" id="task-count">0 个任务</span>
        </div>
        <div class="panel-list" id="task-list"></div>
        <div class="panel-foot">
          <div class="workspace" id="workspace-display">
            <span class="w-dot"></span>—
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 主区域 -->
  <div class="main">

    <!-- 进程：home -->
    <div class="view" id="view-process">
      <div class="home" id="home-view">
        <div class="hero">
          <div class="glow"></div>
          <div class="norp-logo"><span class="logo-shine"></span>N</div>
          <span class="kicker">✦ NORP 智能体</span>
          <h1>把想法变成现实</h1>
          <p>直接描述你想做的事，我来规划、执行、交付</p>
        </div>
        <div class="hero-input">
          <div class="hero-tools">
            <button class="pick" id="home-btn-mode"><span id="home-mode-label">模式</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <button class="pick" id="home-btn-model"><span id="home-model-label">deepseek-chat</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <button class="pick" id="home-btn-perm"><span id="home-perm-label">Workspace Write</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <button class="pick" id="home-btn-think"><span id="home-think-label">标准</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
          <textarea class="hi-input" id="home-input" rows="2" placeholder="描述你想做的事，例如：帮我梳理项目结构并写一份 README…"></textarea>
          <div class="hi-foot">
            <span class="hi-hint">Enter 创建任务 · Ctrl+Enter 换行</span>
            <div class="spacer"></div>
            <button class="send" id="home-send">新建任务 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 14-7-4 14-3-6z"/></svg></button>
          </div>
        </div>
      </div>

      <!-- 进程：chat -->
      <div class="chat-view hidden" id="chat-view">
        <div class="chat-top">
          <h3 id="chat-title">—</h3>
          <div class="seg" id="proc-seg">
            <button class="seg-btn active" data-seg="chat">对话</button>
            <button class="seg-btn" data-seg="traj">命令轨迹</button>
          </div>
          <span class="pill" id="chat-pill">空闲</span>
          <button class="icon-btn" id="btn-stop" title="停止"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg></button>
        </div>
        <div class="traj-view hidden" id="traj-view">
          <div class="traj-view-head" id="traj-view-head"></div>
          <div class="traj-view-body"><div class="cmd-log" id="cmd-log"></div></div>
        </div>
        <div class="chat-scroll" id="chat-scroll">
          <div class="chat-inner" id="chat-inner"></div>
        </div>
        <div class="input-wrap">
          <div class="input-box">
            <div class="input-tools">
              <button class="pick" id="btn-mode"><span id="mode-label">模式</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <button class="pick" id="btn-model"><span id="model-label">deepseek-chat</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <button class="pick" id="btn-perm"><span id="perm-label">Workspace Write</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <button class="pick" id="btn-think"><span id="think-label">标准</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="right">
                <button class="btn-settings" id="btn-settings-input" title="设置">⚙</button>
                <button class="pick dim" id="btn-folder">📁 选择文件夹</button>
              </div>
            </div>
            <textarea class="in" id="input" rows="1" placeholder="输入消息，回车发送，Ctrl+Enter 换行…"></textarea>
            <div class="input-foot">
              <div class="ctx-bar"><span>上下文已用 <b id="ctx-pct">0%</b></span><div class="ctx-track"><div class="ctx-fill" id="ctx-fill" style="width:0%"></div></div></div>
              <div class="spacer"></div>
              <button class="send" id="btn-send">发送 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 14-7-4 14-3-6z"/></svg></button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 技能 -->
    <div class="page hidden" id="view-skills">
      <div class="page-head"><h2>技能</h2><span class="sub">内置能力</span><div class="spacer"></div></div>
      <div class="page-body">
        <div class="skill-grid" id="skill-grid"></div>
      </div>
    </div>

    <!-- 插件 -->
    <div class="page hidden" id="view-plugins">
      <div class="page-head"><h2>插件</h2><span class="sub" id="plugin-sub">—</span><div class="spacer"></div>
        <button class="btn" data-act="reload-plugins">🔄 刷新</button></div>
      <div class="page-body">
        <div class="set-section"><h3>📦 已安装插件</h3><div class="plugin-list" id="plugin-list"></div></div>
        <div class="set-section"><h3>⚙️ 插件设置</h3>
          <div class="check-line"><input type="checkbox" id="pp-plugins-enabled"><span>启用外部插件</span></div>
          <div class="hint-text" style="margin-top:6px;">📁 插件目录</div>
          <div id="pp-dirs" style="margin-top:6px;"></div>
          <div class="ssh-row" style="margin-top:8px;">
            <button class="btn" id="pp-add-dir">+ 添加目录</button>
            <button class="btn" id="pp-reload">🔄 重载插件</button>
          </div>
          <div class="hint-text" style="margin-top:14px;">🛡️ 安全与审计</div>
          <div class="field"><label>安全审计级别</label><select id="pp-audit">
            <option value="off">关闭</option><option value="warn">警告</option><option value="block">拦截（推荐）</option>
          </select></div>
          <div class="field"><label>Import 限制</label><select id="pp-import-restrict">
            <option value="off">关闭</option><option value="safe">安全模式</option><option value="strict">严格（推荐）</option>
          </select></div>
          <div class="check-line"><input type="checkbox" id="pp-permissions"><span>要求插件声明权限</span></div>
          <div class="check-line"><input type="checkbox" id="pp-resource-limit"><span>启用资源限制</span></div>
          <div class="field"><label>隔离模式</label><select id="pp-isolation">
            <option value="process">进程隔离（推荐）</option><option value="inprocess">进程内（调试）</option>
          </select></div>
          <div class="check-line"><input type="checkbox" id="pp-signature"><span>签名校验</span></div>
          <div class="field"><label>网络策略</label><select id="pp-network-policy">
            <option value="deny">拒绝（推荐）</option><option value="allow_all">全部允许</option>
          </select></div>
          <div class="field"><label>URL 白名单（逗号分隔）</label><input type="text" id="pp-url-allowlist"></div>
          <div class="field"><label>域名白名单（逗号分隔）</label><input type="text" id="pp-domain-allowlist"></div>
          <div class="check-line"><input type="checkbox" id="pp-approval"><span>启用人工审批</span></div>
          <div class="ssh-row" style="margin-top:14px;">
            <div class="spacer"></div>
            <button class="btn btn-primary" id="pp-save">保存插件设置</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 自动化 -->
    <div class="page hidden" id="view-automation">
      <div class="page-head"><h2>自动化</h2><span class="sub">定时任务</span><div class="spacer"></div>
        <button class="btn" data-act="new-rule">+ 新建规则</button></div>
      <div class="page-body">
        <div class="empty"><div class="e-icon">⏰</div><p>自动化规则功能规划中<br><span style="font-size:11px;color:#9aa0ab;">支持 5 段 cron 定时任务（norp_task_board 插件）</span></p></div>
      </div>
    </div>

    <!-- 消息 -->
    <div class="page hidden" id="view-messages">
      <div class="page-head"><h2>消息中心</h2><span class="sub">—</span><div class="spacer"></div></div>
      <div class="page-body">
        <div class="msg-list" id="msg-list"></div>
      </div>
    </div>

    <!-- 回退（工作快照 · Undo / Redo / Rollback） -->
    <div class="page hidden" id="view-recovery">
      <style>
        .snap-list{display:flex;flex-direction:column;gap:8px;max-height:52vh;overflow-y:auto}
        .snap-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--border);border-radius:9px;background:var(--surface-2);font-size:12.5px;color:var(--text)}
        .snap-item.cur{border-color:var(--accent);background:var(--accent-soft)}
        .snap-item .si-id{font-family:monospace;color:var(--text-2)}
        .snap-item .si-tag{flex-shrink:0;font-size:11px;padding:1px 7px;border-radius:6px;background:var(--surface-3);color:var(--text-2)}
        .snap-item .si-tag.good{background:#123d24;color:#4ade80}
        .snap-item .si-desc{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .snap-item .si-ops{display:flex;gap:6px;flex-shrink:0}
        .snap-item .si-ops button{padding:3px 10px;font-size:11.5px;border-radius:6px;border:1px solid var(--border);background:var(--surface-3);color:var(--text-2);cursor:pointer}
        .snap-item .si-ops button:hover{color:var(--accent);border-color:var(--accent)}
        .snap-item .si-ops button.danger:hover{color:#f87171;border-color:#f87171}
      </style>
      <div class="page-head"><h2>回退</h2><span class="sub">工作快照 · 撤销 / 恢复 / 回退任意版本</span><div class="spacer"></div>
        <button class="btn" id="rec-capture">📸 手动快照</button>
        <button class="btn" id="rec-undo" title="Ctrl+Z">↩ 撤销</button>
        <button class="btn" id="rec-redo" title="Ctrl+Shift+Z">↪ 恢复</button>
      </div>
      <div class="page-body">
        <div class="hint-text" id="rec-hint">每次系统变更（热挂载 / 设置保存 / 插件安装）自动快照；★ = 最后一次正常工作的快照。</div>
        <div class="set-section"><h3>📜 历史快照</h3><div class="snap-list" id="rec-list"></div></div>
        <div class="set-section"><h3>🚑 崩溃救援</h3>
          <div class="hint-text">主程序无法启动时，用独立命令回退（无需进入界面）：<br>
          <code>norpagent-rescue list</code> 查看快照（★ 为最后正常）<br>
          <code>norpagent-rescue rollback --last-good</code> 一键回退<br>
          安全模式启动：<code>norpagent --safe-mode</code>（代码内 <code>np(safemode='on')</code>）</div>
        </div>
      </div>
    </div>

  </div>

  <!-- 右侧：文件面板（可伸缩） -->
  <div class="right-side" id="right-side">
    <div class="right-panel" id="right-panel">
      <div class="rp-tabs">
        <button class="rp-tab active" data-rtab="files">📁 文件</button>
        <button class="rp-tab" data-rtab="preview">👁 预览</button>
      </div>
      <div class="rp-body">
        <div class="rp-files" id="rp-files">
          <div class="rp-search">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="text" placeholder="搜索文件…" id="rp-search-input">
          </div>
          <div class="rp-tree" id="rp-tree"></div>
        </div>
        <div class="rp-prev hidden" id="rp-prev">
          <div class="rp-prev-head"><span class="rp-prev-title" id="rp-prev-title">—</span><button class="rp-x" id="rp-prev-x">✕</button></div>
          <div class="rp-prev-body" id="rp-prev-body"></div>
        </div>
      </div>
    </div>
    <div class="right-rail">
      <button class="rr-btn" id="rp-toggle" title="文件面板">
        <svg id="rp-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- ═════════ Status bar ═════════ -->
<div class="statusbar">
  <span><span class="dot-live" id="status-dot"></span><span id="status-text">就绪</span></span>
  <span id="status-workspace">—</span>
  <div class="s-right" id="token-display"></div>
</div>

<!-- ═════════ Settings modal ═════════ -->
<div class="modal-overlay" id="settings-modal">
  <div class="modal-card">
    <div class="modal-head"><h2>设置</h2><button class="x-btn" id="settings-x">✕</button></div>
    <div class="modal-body">
      <div class="set-section"><h3>🌐 语言与行为</h3>
        <div class="field"><label>界面语言</label><select id="cfg-language">
          <option value="zh_CN">简体中文</option><option value="zh_TW">繁體中文</option>
          <option value="en">English</option><option value="ru">Русский</option><option value="ja">日本語</option>
        </select></div>
        <div class="field"><label>关闭按钮行为</label><select id="cfg-close-behavior">
          <option value="minimize_to_tray">最小化到托盘</option><option value="exit">直接退出</option>
        </select></div>
      </div>
      <div class="set-section"><h3>🤖 模型与 API</h3>
        <div class="field"><label>模型</label><select id="cfg-model"></select></div>
        <div class="field"><label>API Base URL</label><div class="row"><input type="text" id="cfg-api-base" style="flex:1;"><button class="btn" id="cfg-refresh-models" style="height:32px;padding:0 12px;">🔄 刷新模型</button></div></div>
        <div class="field"><label>API Key</label><div class="row"><input type="password" id="cfg-apikey" placeholder="sk-..." style="flex:1;"><button class="btn" id="cfg-getkey" style="height:32px;padding:0 12px;">获取 Key</button></div></div>
        <div class="check-line"><input type="checkbox" id="cfg-use-responses"><span>启用 Responses API</span></div>
        <div class="field"><label>项目根目录</label><div class="row"><input type="text" id="cfg-project-root" style="flex:1;"><button class="btn" id="cfg-browse" style="height:32px;padding:0 12px;">浏览</button></div></div>
      </div>
      <div class="set-section"><h3>🧠 推理与输出</h3>
        <div class="field"><label>思考级别</label><select id="cfg-think-level"><option value="off">关闭</option><option value="low">低</option><option value="med">中</option><option value="high" selected>高</option></select></div>
        <div class="field"><label>权限模式</label><select id="cfg-permission-mode"><option value="Workspace Write">Workspace Write（读写）</option><option value="Workspace Read">Workspace Read（只读）</option><option value="Full Control">Full Control（全控）</option><option value="ReadOnly">ReadOnly（只读）</option></select></div>
        <div class="field"><label>温度</label><div class="slider-row"><input type="range" id="cfg-temperature" min="0" max="20" value="10"><span class="slider-val" id="cfg-temperature-val">1.0</span></div></div>
        <div class="field"><label>最大输出 tokens</label><input type="number" id="cfg-max-tokens" value="32767"></div>
      </div>
      <div class="set-section"><h3>⚙️ 功能</h3>
        <div class="check-line"><input type="checkbox" id="cfg-web-search"><span>联网搜索</span></div>
        <div class="check-line"><input type="checkbox" id="cfg-native-confirm-write" checked><span>写入前确认</span></div>
        <div class="check-line"><input type="checkbox" id="cfg-native-confirm-delete" checked><span>删除前确认</span></div>
        <div class="check-line"><input type="checkbox" id="cfg-native-confirm-exec"><span>执行命令前确认</span></div>
      </div>
      <div class="set-section"><h3>📋 记忆（对话历史）</h3>
        <div class="check-line"><input type="checkbox" id="cfg-memory"><span>启用记忆持久化</span></div>
        <div class="field" style="margin-top:8px;"><label>记忆模式</label><select id="cfg-memory-mode"><option value="full">完整（保留所有轮次）</option><option value="summary">摘要</option></select></div>
        <div class="field"><label>最大轮次</label><input type="number" id="cfg-max-rounds" min="1" max="50" value="10"></div>
        <div class="field"><button class="btn" id="cfg-clear-memory">🧹 清除记忆</button></div>
      </div>
      <div class="set-section"><h3>🔌 插件</h3>
        <div class="hint-text">插件启用开关、插件目录、插件列表、安全审计、签名校验、网络策略与人工审批等已移至左侧「插件」页面</div>
      </div>
      <div class="set-section"><h3>⚙️ 高级</h3>
        <div class="field"><label>队列上限</label><input type="number" id="cfg-queue-size" min="1" max="1024" value="200"></div>
        <div class="field"><label>最大步数</label><input type="number" id="cfg-max-steps" min="1" max="512" value="128"></div>
        <div class="field"><label>任务超时（秒，0 = 不限）</label><input type="number" id="cfg-task-timeout" min="0" value="0"></div>
      </div>
      <div class="set-section"><h3>🛡️ 安全</h3>
        <div class="check-line"><input type="checkbox" id="cfg-norp-safe" checked><span>NORP 安全系统</span></div>
        <div class="hint-text" id="cfg-norp-safe-status">安全系统已启用 — 危险操作将被拦截</div>
        <div class="check-line" style="margin-top:8px;"><input type="checkbox" id="cfg-jailbreak" checked><span>越狱/注入防护</span></div>
        <div class="field" style="margin-top:6px;"><label>检测到攻击时的操作</label><select id="cfg-jailbreak-action">
          <option value="block">拦截消息（推荐）</option><option value="warn">仅记录日志</option>
        </select></div>
        <div class="hint-text" id="cfg-jailbreak-status">越狱防护已启用 — 恶意注入将被拦截</div>
      </div>
      <div class="set-section"><h3>🩺 运行时健康检查</h3>
        <div class="hint-text" id="cfg-health-status">正在加载…</div>
        <div class="field" style="margin-top:6px;"><button class="btn" id="cfg-health-refresh">🔄 刷新</button></div>
      </div>
      <div class="set-section"><h3>👁️ 视觉 API</h3>
        <div class="check-line"><input type="checkbox" id="cfg-vision"><span>启用视觉 API</span></div>
        <div class="field" style="margin-top:6px;"><label>外部视觉服务地址</label><input type="text" id="cfg-vision-url"></div>
      </div>
      <div class="set-section" id="remote-settings-section"><h3>📱 移动端远程控制</h3>
        <div class="check-line"><input type="checkbox" id="cfg-remote-enabled"><span>启用远程访问（重启生效）</span></div>
        <div class="field" style="margin-top:8px;"><label>绑定地址</label><input type="text" id="cfg-remote-host" value="127.0.0.1"></div>
        <div class="field"><label>端口</label><input type="number" id="cfg-remote-port" value="8090"></div>
      </div>
      <div class="set-section" style="border-bottom:none;padding-bottom:4px;">
        <button class="btn btn-debug" id="cfg-debug" style="width:100%;">🛠️ 调试（Agent 运行诊断）</button>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" id="settings-restore">恢复默认</button>
      <div class="spacer"></div>
      <button class="btn" id="settings-cancel">取消</button>
      <button class="btn btn-primary" id="settings-save">保存</button>
    </div>
  </div>
</div>

<!-- ═════════ SSH modal ═════════ -->
<div class="modal-overlay" id="ssh-modal">
  <div class="modal-card">
    <div class="modal-head"><h2>🔌 SSH 远程运维</h2><button class="x-btn" id="ssh-x">✕</button></div>
    <div class="modal-body">
      <div class="ssh-box">
        <div class="ssh-row"><input type="text" id="ssh-host-search" placeholder="搜索别名/主机…" style="flex:1;"><button class="btn" id="ssh-refresh">刷新</button><button class="btn" id="ssh-import">导入配置</button></div>
        <div class="ssh-host-list" id="ssh-host-list"></div>
        <div class="ssh-row" style="margin-top:10px;">
          <select id="ssh-exec-host" style="flex:1;"></select>
          <input type="number" id="ssh-exec-timeout" value="60" style="width:80px;" title="超时秒">
        </div>
        <textarea id="ssh-exec-cmd" placeholder="要执行的命令，如 df -h" style="width:100%;height:60px;"></textarea>
        <div class="ssh-row" style="margin-top:6px;"><button class="btn btn-primary" id="ssh-exec-run">执行</button></div>
        <pre id="ssh-exec-output" class="ssh-output">—</pre>
      </div>
    </div>
  </div>
</div>

<!-- ═════════ Remote modal ═════════ -->
<div class="modal-overlay" id="remote-modal">
  <div class="modal-card">
    <div class="modal-head"><h2>📱 移动端远程控制</h2><button class="x-btn" id="remote-x">✕</button></div>
    <div class="modal-body">
      <div id="remote-body" class="remote-body"></div>
    </div>
  </div>
</div>

<!-- ═════════ Ask user modal ═════════ -->
<div class="modal-overlay" id="ask-user-modal">
  <div class="modal-card" style="max-width:480px;">
    <div class="modal-head"><h2>🤖 Agent 提问</h2><button class="x-btn" id="ask-user-cancel">✕</button></div>
    <div class="modal-body">
      <div id="ask-user-question"></div>
      <textarea id="ask-user-reply-input" placeholder="输入你的回复…" style="width:100%;height:80px;border:1px solid #e6e8ec;border-radius:8px;padding:10px;font-size:13px;resize:none;"></textarea>
      <p class="hint-text">Enter 回复 · Esc 取消任务</p>
    </div>
    <div class="modal-foot">
      <button class="btn btn-danger" id="ask-user-cancel-task">取消任务</button>
      <div class="spacer"></div>
      <button class="btn btn-primary" id="ask-user-reply">回复</button>
    </div>
  </div>
</div>

<!-- ═════════ Confirm write modal ═════════ -->
<div class="modal-overlay" id="confirm-write-modal">
  <div class="modal-card" style="max-width:480px;">
    <div class="modal-head"><h2>⚠️ 确认操作</h2></div>
    <div class="modal-body">
      <p id="confirm-write-message" style="font-size:13px;line-height:1.7;"></p>
      <p id="confirm-write-detail" style="font-size:12px;color:#9aa0ab;margin-top:8px;"></p>
    </div>
    <div class="modal-foot">
      <button class="btn btn-danger" id="confirm-write-cancel">取消</button>
      <div class="spacer"></div>
      <button class="btn btn-primary" id="confirm-write-ok">确认</button>
    </div>
  </div>
</div>

<!-- ═════════ Plugin panel modal（已并入插件页面，此弹窗移除） ═════════ -->

<!-- ═════════ 模块流程编排 FLOW 浮层 ═════════ -->
<div id="flow-overlay">
  <div class="fo-head">
    <span class="fo-title" id="flow-overlay-title">🧩 模块流程编排 · FLOW</span>
    <button id="flow-overlay-open">↗ 新窗口打开</button>
    <button id="flow-overlay-close">✕ 关闭</button>
  </div>
  <iframe id="flow-frame" src="about:blank" title="norpflow"></iframe>
</div>

<!-- ═════════ Debug modal ═════════ -->
<div class="modal-overlay" id="debug-modal">
  <div class="modal-card" style="max-width:720px;">
    <div class="modal-head"><h2>🛠️ Agent 调试面板</h2><button class="x-btn" id="debug-x">✕</button></div>
    <div class="modal-body">
      <div style="display:flex;gap:6px;margin-bottom:10px;">
        <button class="btn" id="debug-refresh">🔄 刷新</button>
        <button class="btn" id="debug-open-log">📂 打开日志目录</button>
      </div>
      <div id="debug-summary" class="hint-text" style="margin-bottom:10px;">正在加载…</div>
      <div id="debug-rows"></div>
      <details id="debug-raw-wrap" style="margin-top:12px;">
        <summary style="font-size:12px;color:var(--text-3);cursor:pointer;user-select:none;">原始数据（JSON）</summary>
        <pre id="debug-content" class="debug-content"></pre>
      </details>
    </div>
  </div>
</div>

<div class="toasts" id="toasts"></div>

<script>
// ═══════════════════════════════════════════════════════════════
//  NORP Agent 新前端 — CORE
//  Copyright (c) 2026 xbm666, MIT Licensed
// ═══════════════════════════════════════════════════════════════
/* NORP Agent 新前端 · 核心逻辑
   Copyright (c) 2026 xbm666, MIT Licensed */
(function(){
  var $=function(s){return document.querySelector(s)};
  var $$=function(s){return Array.prototype.slice.call(document.querySelectorAll(s))};

  /* ── 全局状态 ── */
  var sessions={};          // sid -> {title, hasTask, running, msgs:[], cmds:[], tokens:{}}
  var activeSid=null;
  var activeSeg='chat';
  var config={};
  var pollTimer=null;
  var _pendingAskSid=null;
  var _pendingConfirm=null; // {sid, tool, path}
  var _typingEl=null;
  var _curReply=null;       // 当前助手回复容器
  var _streaming=false;     // 是否正在流式回复
  var _idleSyncCount=0;     // 最近一次历史条数（idleSync 对比用）
  // 单换行也渲染为换行，避免回复段落粘在一起
  if(window.marked){try{marked.setOptions({breaks:true});}catch(e){}}

  /* ── 工具 ── */
  function showToast(msg){
    var box=document.getElementById('toasts');
    var t=document.createElement('div');t.className='toast';t.textContent=msg;
    box.appendChild(t);
    requestAnimationFrame(function(){t.classList.add('show')});
    setTimeout(function(){t.classList.remove('show');setTimeout(function(){t.remove()},300)},2400);
  }
  function esc(s){
    return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function setStatus(txt){
    var el=$('#status-text');if(el)el.textContent=txt;
  }
  function apiReady(){ return !!(window.pywebview && window.pywebview.api); }
  function call(name){
    var args=Array.prototype.slice.call(arguments,1);
    if(!apiReady())return Promise.reject(new Error('API 未就绪'));
    var fn=window.pywebview.api[name];
    if(typeof fn!=='function')return Promise.reject(new Error('方法不存在: '+name));
    return fn.apply(null,args);
  }

  /* ── 视图切换 ── */
  var viewMap={process:'view-process',skills:'view-skills',plugins:'view-plugins',automation:'view-automation',messages:'view-messages',recovery:'view-recovery'};
  function activateNav(nav){
    $$('.rail-item').forEach(function(x){x.classList.toggle('active',x.getAttribute('data-nav')===nav)});
    if(nav==='settings'){openSettings();return;}
    if(nav==='ssh'){openSsh();return;}
    if(nav==='remote'){openRemote();return;}
    Object.keys(viewMap).forEach(function(k){
      $('#'+viewMap[k]).classList.toggle('hidden',k!==nav);
    });
    if(nav==='plugins')renderPlugins();
    if(nav==='skills')renderSkills();
    if(nav==='messages')renderMessages();
    if(nav==='recovery')renderRecovery();
  }
  $$('.rail-item').forEach(function(it){
    it.addEventListener('click',function(){activateNav(it.getAttribute('data-nav'))});
  });

  /* ── 工作回退（快照 / Undo / Redo / Rollback） ── */
  var _recoveryBusy=false;
  function recAction(action,payload){
    if(_recoveryBusy){showToast('回退操作进行中…');return Promise.resolve(null);}
    _recoveryBusy=true;
    var p=Promise.resolve().then(function(){
      return call('snapshot_action',action,payload||{});
    });
    p.then(function(d){
      if(d&&d.ok){showToast('已完成：'+(action==='undo'?'撤销':action==='redo'?'恢复':action==='rollback'?'回退':action==='capture'?'已快照':'已标记正常'));}
      else if(d&&d.error){showToast('失败：'+d.error);}
    }).catch(function(e){showToast('回退失败：'+(e&&e.message?e.message:e));})
      .then(function(){_recoveryBusy=false;renderRecovery();});
    return p;
  }
  function renderRecovery(){
    var list=$('#rec-list');if(!list)return;
    if(typeof call!=='function'){list.textContent='—';return;}
    var p;
    try{p=call('list_snapshots');}catch(e){p=Promise.reject(e);}
    Promise.resolve(p).then(function(items){
      list.innerHTML='';
      if(!items||!items.length){
        var empty=document.createElement('div');
        empty.className='hint-text';
        empty.textContent='（暂无快照：启动基线快照会在引擎启动时自动生成）';
        list.appendChild(empty);
        return;
      }
      items.forEach(function(it){
        var row=document.createElement('div');
        row.className='snap-item'+(it.is_current?' cur':'');
        var tag=document.createElement('span');
        tag.className='si-tag'+(it.is_last_good?' good':'');
        tag.textContent=(it.is_last_good?'★':'')+(it.tag||'')+(it.good?'·正常':'');
        var id=document.createElement('span');
        id.className='si-id';
        id.textContent=(it.id||'').slice(0,21);
        var desc=document.createElement('span');
        desc.className='si-desc';
        desc.title=it.description||'';
        desc.textContent=it.description||'';
        var ops=document.createElement('span');
        ops.className='si-ops';
        var btnGo=document.createElement('button');
        btnGo.textContent='回退';
        btnGo.addEventListener('click',function(){recAction('rollback',{id:it.id});});
        var btnGood=document.createElement('button');
        btnGood.textContent='标记正常';
        btnGood.addEventListener('click',function(){recAction('mark_good',{id:it.id});});
        ops.appendChild(btnGo);
        ops.appendChild(btnGood);
        row.appendChild(tag);row.appendChild(id);row.appendChild(desc);row.appendChild(ops);
        list.appendChild(row);
      });
    }).catch(function(){list.textContent='当前宿主不支持工作回退面板（可用 norpagent-rescue 命令或 API）';});
  }
  function _bindRecoveryButtons(){
    var capture=$('#rec-capture'),undo=$('#rec-undo'),redo=$('#rec-redo');
    if(capture)capture.addEventListener('click',function(){recAction('capture',{description:'手动快照'});});
    if(undo)undo.addEventListener('click',function(){recAction('undo');});
    if(redo)redo.addEventListener('click',function(){recAction('redo');});
    // 全局快捷键：Ctrl+Z 撤销 / Ctrl+Shift+Z 或 Ctrl+Y 恢复
    document.addEventListener('keydown',function(e){
      if(!(e.ctrlKey||e.metaKey))return;
      var tag=(document.activeElement&&document.activeElement.tagName||'').toLowerCase();
      var typing=(tag==='textarea'||tag==='input');
      var k=(e.key||'').toLowerCase();
      if(k==='z'&&!e.shiftKey&&!typing){e.preventDefault();recAction('undo');}
      else if((k==='z'&&e.shiftKey)||k==='y'){if(typing&&k==='y')return;e.preventDefault();recAction('redo');}
    });
  }
  _bindRecoveryButtons();

  /* ── 顶栏菜单 ── */
  var MENUS={
    help:[
      {label:'版本',act:function(){showToast('v0.5');}},
      {label:'快捷键',act:function(){showToast('Enter 发送 · Ctrl+Enter 换行');}}
    ]
  };
  $$('.menu-item').forEach(function(it){
    var key=it.getAttribute('data-menu');
    var items=MENUS[key]||[];
    var drop=document.createElement('div');drop.className='menu-drop';
    items.forEach(function(itm){
      if(itm.sep){var s=document.createElement('div');s.className='md-sep';drop.appendChild(s);return;}
      var b=document.createElement('button');b.className='md-item';b.textContent=itm.label;
      b.addEventListener('click',function(){drop.classList.remove('open');itm.act();});
      drop.appendChild(b);
    });
    it.appendChild(drop);
    it.addEventListener('click',function(e){
      e.stopPropagation();
      $$('.menu-drop').forEach(function(d){if(d!==drop)d.classList.remove('open')});
      drop.classList.toggle('open');
    });
  });
  document.addEventListener('click',function(){
    $$('.menu-drop').forEach(function(d){d.classList.remove('open')});
  });
  // 余额
  $('#balance-chip').addEventListener('click',async function(){
    try{
      var b=await call('get_balance');
      if(b&&b.error){showToast('余额查询失败：'+b.error);return;}
      if(b&&b.balance_infos&&b.balance_infos.length){
        var info=b.balance_infos[0];
        showToast('总余额 '+fmtBalance(b)+' ｜ 赠送 '+info.granted_balance+' ｜ 充值 '+(info.topped_up_balance!=null?info.topped_up_balance:'—'));
        $('#balance-val').textContent=fmtBalance(b);
      }else{
        showToast('余额不可用');
      }
    }catch(e){showToast('余额查询失败：'+e.message);}
  });
  // 流程编排（接入原版 /flow 界面）
  var flowOverlay=document.getElementById('flow-overlay');
  var flowFrame=document.getElementById('flow-frame');
  var flowTitle=document.getElementById('flow-overlay-title');
  function openFlow(){
    if(!flowOverlay||!flowFrame)return;
    flowFrame.src='/flow';
    if(flowTitle)flowTitle.textContent='🧩 模块流程编排 · FLOW';
    flowOverlay.classList.add('open');
  }
  function closeFlow(){
    if(!flowOverlay)return;
    flowOverlay.classList.remove('open');
    setTimeout(function(){if(flowFrame)flowFrame.src='about:blank';},150);
  }
  $('#flow-btn').addEventListener('click',openFlow);
  $('#flow-overlay-close').addEventListener('click',closeFlow);
  $('#flow-overlay-open').addEventListener('click',function(){
    try{if(flowFrame&&flowFrame.src)window.open(flowFrame.src,'_blank');}catch(e){}
  });
  window.addEventListener('message',function(e){
    var d=null;try{d=e.data||null;}catch(err){return;}
    if(d&&d.type==='norpflow-close')closeFlow();
  });
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&flowOverlay&&flowOverlay.classList.contains('open')){e.stopPropagation();closeFlow();}
  },true);

  /* ── 首页 / 新建任务 ── */
  function goHome(){
    $('#chat-view').classList.add('hidden');
    $('#home-view').classList.remove('hidden');
    activateNav('process');
  }
  $('#btn-new-task').addEventListener('click',goHome);

  function homeCreate(){
    var v=$('#home-input').value.trim();
    if(!v){showToast('先描述你想做的事');$('#home-input').focus();return;}
    $('#home-input').value='';
    createTask(v);
  }
  $('#home-send').addEventListener('click',homeCreate);
  $('#home-input').addEventListener('keydown',function(e){
    if(e.key==='Enter'&&!e.ctrlKey&&!e.shiftKey){e.preventDefault();homeCreate();}
  });

  async function createTask(text){
    var sid;
    try{
      sid=await call('create_session', config.project_root||'');
    }catch(e){
      try{sid=await call('get_sessions').then(function(ss){return ss&&ss.length?ss[0].id:null;});}catch(e2){}
      if(!sid){showToast('创建会话失败');return;}
    }
    sessions[sid]={title:firstLine(text),hasTask:false,running:false,msgs:[],cmds:[],tokens:{}};
    activeSid=sid;
    try{await call('set_session_title',sid,firstLine(text));}catch(e){}
    refreshIslands();
    jumpToSession(sid,true);
    await sendMessage(text);
  }
  function firstLine(t){
    t=(t||'').trim().replace(/\s+/g,' ');
    return t.length>14?t.slice(0,14)+'…':(t||'新任务');
  }

  /* ── 进程岛 ── */
  function refreshIslands(){
    var list=$('#task-list');
    list.innerHTML='';
    Object.keys(sessions).forEach(function(sid){
      var s=sessions[sid];
      var island=document.createElement('div');
      island.className='island '+(s.running?'running':(s.hasTask?'done':'idle'));
      if(sid===activeSid)island.classList.add('active');
      island.setAttribute('data-sid',sid);
      island.innerHTML='<span class="is-dot"></span><span class="is-title">'+esc(s.title)+'</span>'+
        '<span class="is-tag">'+(s.running?'运行中':(s.hasTask?'已完成':'空闲'))+'</span>';
      island.addEventListener('click',function(){jumpToSession(sid);});
      list.appendChild(island);
    });
    var n=Object.keys(sessions).length;
    $('#pc-count').textContent=n;
    $('#task-count').textContent=n+' 个任务';
    var ws=config.project_root||'—';
    $('#workspace-display').innerHTML='<span class="w-dot"></span>'+esc(ws);
    $('#status-workspace').textContent=ws;
  }

  function jumpToSession(sid,keepHome){
    activeSid=sid;
    var s=sessions[sid];
    if(!s)return;
    refreshIslands();
    if(!keepHome){
      $('#home-view').classList.add('hidden');
      $('#chat-view').classList.remove('hidden');
    }
    $('#chat-title').textContent=s.title;
    $('#chat-pill').textContent=s.running?'运行中':(s.hasTask?'已完成':'空闲');
    $('#chat-pill').classList.toggle('done',!s.running&&s.hasTask);
    var inner=$('#chat-inner');
    inner.innerHTML='';
    _curReply=null;
    s.msgs.forEach(function(m){renderMsg(m.role,m.text,m.type,m.thinking);});
    scrollChat();
    if(activeSeg==='traj')renderTrajectory();
    startPolling();
  }

  /* ── 聊天渲染 ── */
  function renderMsg(role,text,type,thinking){
    var inner=$('#chat-inner');
    var wrap=document.createElement('div');
    wrap.className='msg '+role;
    wrap.innerHTML='<div class="m-avatar">'+(role==='user'?'你':'N')+'</div><div class="m-body"><div class="m-meta"><b>'+(role==='user'?'你':'NORP Agent')+'</b></div><div class="m-bubble"></div></div>';
    var bubble=wrap.querySelector('.m-bubble');
    if(role==='user'){
      bubble.textContent=text;
    }else if(type==='error'){
      bubble.style.color='var(--red)';
      bubble.textContent=text;
    }else{
      var html='';
      if(thinking)html+='<div class="thinking-box collapsed"><div class="th-title">🧠 思考过程 <svg class="th-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 4.5 2.5 2.5L9 4.5"/></svg></div><div class="th-body"></div></div>';
      if(window.marked){
        bubble.innerHTML=html+marked.parse(text||'');
        if(thinking)bubble.querySelector('.th-body').textContent=thinking;
      }else{
        bubble.textContent=text;
        if(thinking){
          var tb=document.createElement('div');tb.className='thinking-box collapsed';
          tb.innerHTML='<div class="th-title">🧠 思考过程 <svg class="th-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 4.5 2.5 2.5L9 4.5"/></svg></div><div class="th-body"></div>';
          tb.querySelector('.th-body').textContent=thinking;
          bubble.insertBefore(tb,bubble.firstChild);
        }
      }
    }
    inner.appendChild(wrap);
    scrollChat();
  }

  function ensureAssistantBubble(){
    var inner=$('#chat-inner');
    if(_curReply && inner.contains(_curReply))return _curReply;
    _curReply=document.createElement('div');
    _curReply.className='msg assistant';
    _curReply.innerHTML='<div class="m-avatar">N</div><div class="m-body"><div class="m-meta"><b>NORP Agent</b></div><div class="m-bubble"></div></div>';
    inner.appendChild(_curReply);
    return _curReply;
  }
  function ensureThinking(){
    var b=ensureAssistantBubble();
    var box=b.querySelector('.thinking-box');
    if(box)return box.querySelector('.th-body');
    var div=document.createElement('div');
    div.className='thinking-box collapsed';
    div.innerHTML='<div class="th-title">🧠 思考过程 <svg class="th-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 4.5 2.5 2.5L9 4.5"/></svg></div><div class="th-body"></div>';
    b.querySelector('.m-bubble').insertBefore(div,b.querySelector('.m-bubble').firstChild);
    return div.querySelector('.th-body');
  }
  function removeTyping(){
    if(_typingEl&&_typingEl.parentNode){_typingEl.parentNode.removeChild(_typingEl);}
    _typingEl=null;
  }
  function showTyping(){
    removeTyping();
    var inner=$('#chat-inner');
    _typingEl=document.createElement('div');
    _typingEl.className='msg assistant';
    _typingEl.innerHTML='<div class="m-avatar">N</div><div class="m-body"><div class="m-meta"><b>NORP Agent</b> · 正在思考</div><div class="typing"><i></i><i></i><i></i></div></div>';
    inner.appendChild(_typingEl);
    scrollChat();
  }
  function scrollChat(){
    var sc=$('#chat-scroll');
    if(sc)sc.scrollTop=sc.scrollHeight;
  }

  /* ── 事件处理（按会话累积，切走不丢）── */
  function handleEvent(ev,sid){
    var s=sessions[sid];
    if(!s)return;
    if(ev==='WAIT'||ev===null||ev==='')return;
    var isActive=(activeSid===sid);
    if(ev.indexOf('T:')===0){
      removeTyping();
      s.thinkAcc=(s.thinkAcc||'')+ev.slice(2);
      if(isActive)ensureThinking().textContent=s.thinkAcc;
      scrollChat();
    }else if(ev.indexOf('R:')===0){
      removeTyping();
      s.replyAcc=(s.replyAcc||'')+ev.slice(2);
      if(isActive){
        var bubble=ensureAssistantBubble().querySelector('.m-bubble');
        if(window.marked){bubble.innerHTML=marked.parse(s.replyAcc);}
        else{bubble.textContent=s.replyAcc;}
      }
      scrollChat();
    }else if(ev.indexOf('C:')===0){
      pushCommand(ev.slice(2),sid);
    }else if(ev.indexOf('U:')===0){
      try{
        var u=JSON.parse(ev.slice(2));
        s.tokens={input:u.input||0,output:u.output||0,tool:u.tool_call_tokens||u.tool||0,total:u.total||0};
        updateTokens();
        updateCtxBar(u);
      }catch(e){}
    }else if(ev.indexOf('E:')===0){
      removeTyping();
      var errText=ev.slice(2);
      s.msgs.push({role:'assistant',text:errText,type:'error'});
      if(isActive)renderMsg('assistant',errText,'error');
    }else if(ev.indexOf('Q:')===0){
      var q=ev.slice(2);
      try{var qj=JSON.parse(q);q=qj.question||q;}catch(e){}
      showAskUser(q,sid);
    }else if(ev.indexOf('WC:')===0){
      var c;
      try{c=JSON.parse(ev.slice(3));}catch(e){c={tool:'write_file',path:''};}
      _pendingConfirm={sid:sid,tool:c.tool,path:c.path};
      $('#confirm-write-message').textContent='Agent 准备执行「'+(c.tool||'写文件')+'」操作';
      $('#confirm-write-detail').textContent=c.path||'';
      $('#confirm-write-modal').classList.add('open');
    }else if(ev.indexOf('D:')===0){
      removeTyping();
    }else if(ev.indexOf('M:')===0){
      // 其它端（如移动端）发的用户消息；本端刚发的同一条会经 M: 回显，需去重
      var mtext=ev.slice(2);
      var last=s.msgs[s.msgs.length-1];
      if(last&&last.role==='user'&&last.text===mtext)return;
      s.msgs.push({role:'user',text:mtext});
      if(isActive)renderMsg('user',mtext);
    }
  }
  function updateTokens(){
    var s=sessions[activeSid];if(!s)return;
    var td=$('#token-display');
    if(!td)return;
    td.innerHTML='<span class="tok">输入 <b>'+fmtK(s.tokens.input)+'</b></span>'+
      '<span class="tok">输出 <b>'+fmtK(s.tokens.output)+'</b></span>'+
      '<span class="tok">工具 <b>'+fmtK(s.tokens.tool)+'</b></span>'+
      '<span class="tok">总计 <b>'+fmtK(s.tokens.total)+'</b></span>';
  }
  function fmtK(n){n=n||0;return n>=1000?(n/1000).toFixed(1)+'k':String(n);}
  function updateCtxBar(u){
    var pct=u&&u.context_percent!=null?u.context_percent:(u&&u.total?Math.min(100,Math.round(u.total/160000*100)):0);
    pct=Math.max(0,Math.min(100,pct));
    $('#ctx-pct').textContent=pct+'%';
    $('#ctx-fill').style.width=pct+'%';
  }

  /* ── 轮询（单轮询器跟随当前会话）── */
  function stopPolling(){
    if(pollTimer){clearInterval(pollTimer);pollTimer=null;}
  }
  function startPolling(){
    stopPolling();
    pollTimer=setInterval(async function(){
      if(!activeSid)return;
      var sid=activeSid;
      var s=sessions[sid];
      if(!s)return;
      try{
        var ev=await call('get_next_event',sid);
        if(ev===null){
          stopPolling();
          _streaming=false;
          s.running=false;s.hasTask=true;
          // 把本轮回复持久化到会话，离开再回来可见
          s.replyAcc=s.replyAcc||'';s.thinkAcc=s.thinkAcc||'';
          if(s.replyAcc||s.thinkAcc){
            s.msgs.push({role:'assistant',text:s.replyAcc,thinking:s.thinkAcc});
          }
          s.replyAcc='';s.thinkAcc='';
          if(activeSid===sid){
            $('#chat-pill').textContent='已完成';
            $('#chat-pill').classList.add('done');
          }
          refreshIslands();
          _curReply=null;
          removeTyping();
          return;
        }
        if(ev==='WAIT')return;
        handleEvent(ev,sid);
      }catch(e){
        stopPolling();
      }
    },120);
  }

  /* ── 空闲同步：手机等其它端发的消息，桌面端定期拉历史对比重绘 ── */
  async function idleSync(){
    if(_streaming||!activeSid)return;
    if(document.getElementById('ask-user-modal').classList.contains('open')||
       document.getElementById('confirm-write-modal').classList.contains('open'))return;
    var s=sessions[activeSid];if(!s)return;
    try{
      var hist=await call('get_initial_messages',activeSid);
      var n=(hist&&hist.length)||0;
      if(n!==_idleSyncCount){
        _idleSyncCount=n;
        var msgs=[];
        (hist||[]).forEach(function(m){
          if(m&&m.role)msgs.push({role:m.role==='assistant'?'assistant':'user',text:m.content||m.text||''});
        });
        s.msgs=msgs;
        jumpToSession(activeSid,true);
      }
    }catch(e){}
  }
  setInterval(idleSync,1200);

  /* ── 命令轨迹 ── */
  function pushCommand(raw,sid){
    var s=sessions[sid||activeSid];if(!s)return;
    var entry={tool:'command',args:[],out:'',status:'done',raw:raw};
    try{
      var j=JSON.parse(raw);
      entry.tool=j.tool||'tool';
      var args=j.args||{};
      entry.args=Object.keys(args).map(function(k){return {k:k,v:typeof args[k]==='string'?args[k]:JSON.stringify(args[k])};});
      if(j.result!==undefined){entry.out=typeof j.result==='string'?j.result:JSON.stringify(j.result);}
      else if(j.output!==undefined){entry.out=typeof j.output==='string'?j.output:JSON.stringify(j.output);}
      if(j.ok===false)entry.status='fail';
    }catch(e){
      entry.tool=raw.split(/\s|\(/)[0]||'command';
      entry.args=[{k:'text',v:raw.slice(0,120)}];
    }
    s.cmds.push(entry);
    if(activeSeg==='traj'&&activeSid===sid)renderTrajectory();
  }
  function renderTrajectory(){
    var s=sessions[activeSid];if(!s)return;
    $('#traj-view-head').innerHTML='<b>'+esc(s.title)+'</b> 的命令行记录 <span class="tv-tag">'+s.cmds.length+' 条命令</span>';
    var log=$('#cmd-log');
    if(!s.cmds.length){log.innerHTML='<div class="cmd-empty">（该任务暂无命令记录）</div>';return;}
    log.innerHTML='';
    s.cmds.forEach(function(st){
      var e=document.createElement('div');
      e.className='cmd-entry '+(st.status==='fail'?'fail':'done');
      var argsHtml='';
      (st.args||[]).forEach(function(a){
        argsHtml+='<div class="cmd-args"><span class="k">'+esc(a.k)+'</span>: '+esc(a.v)+'</div>';
      });
      var outHtml=st.out?'<div class="cmd-out">'+esc(st.out)+'</div>':'';
      e.innerHTML='<div class="cmd-tool">'+esc(st.tool)+'</div>'+argsHtml+outHtml+
        '<div class="cmd-status">'+(st.status==='fail'?'✕ 失败':'✓ 完成')+'</div>';
      log.appendChild(e);
    });
  }
  $$('#proc-seg .seg-btn').forEach(function(b){
    b.addEventListener('click',function(){
      $$('#proc-seg .seg-btn').forEach(function(x){x.classList.remove('active')});
      b.classList.add('active');
      activeSeg=b.getAttribute('data-seg');
      if(activeSeg==='traj'){
        $('#chat-scroll').classList.add('hidden');
        document.querySelector('#chat-view .input-wrap').classList.add('hidden');
        $('#traj-view').classList.remove('hidden');
        renderTrajectory();
      }else{
        $('#traj-view').classList.add('hidden');
        $('#chat-scroll').classList.remove('hidden');
        document.querySelector('#chat-view .input-wrap').classList.remove('hidden');
      }
    });
  });

  /* ── 发送 ── */
  async function sendMessage(text){
    if(!activeSid){showToast('请先创建任务');return;}
    text=(text||'').trim();
    if(!text)return;
    var s=sessions[activeSid];
    $('#home-view').classList.add('hidden');
    $('#chat-view').classList.remove('hidden');
    if(activeSeg!=='chat'){
      activeSeg='chat';
      $$('#proc-seg .seg-btn').forEach(function(x){x.classList.toggle('active',x.getAttribute('data-seg')==='chat')});
      $('#traj-view').classList.add('hidden');
      $('#chat-scroll').classList.remove('hidden');
      document.querySelector('#chat-view .input-wrap').classList.remove('hidden');
    }
    s.running=true;s.hasTask=false;
    $('#chat-pill').textContent='运行中';
    $('#chat-pill').classList.remove('done');
    refreshIslands();
    s.msgs.push({role:'user',text:text});
    renderMsg('user',text);
    showTyping();
    s.replyAcc='';s.thinkAcc='';_curReply=null;
    _streaming=true;
    try{
      var res=await call('send_message',activeSid,text);
      if(typeof res==='string'&&res.indexOf('error:')===0){
        removeTyping();
        renderMsg('assistant',res.slice(6),'error');
        s.running=false;_streaming=false;refreshIslands();
        return;
      }
      startPolling();
    }catch(e){
      removeTyping();
      renderMsg('assistant','发送失败：'+e.message,'error');
      s.running=false;_streaming=false;refreshIslands();
    }
  }
  function doSend(){sendMessage($('#input').value).then(function(){$('#input').value='';});}
  $('#btn-send').addEventListener('click',doSend);
  $('#input').addEventListener('keydown',function(e){
    if(e.key==='Enter'&&!e.ctrlKey&&!e.shiftKey){e.preventDefault();doSend();}
  });
  $('#btn-stop').addEventListener('click',function(){
    if(activeSid){call('stop_task',activeSid).catch(function(){});}
    var s=sessions[activeSid];if(s){s.running=false;refreshIslands();}
    stopPolling();
    $('#chat-pill').textContent='已停止';
    showToast('⏹ 已请求停止任务');
  });

  /* ── 提问 / 确认 ── */
  function showAskUser(question,sid){
    _pendingAskSid=sid||activeSid;
    $('#ask-user-question').innerHTML='<div style="font-size:13px;line-height:1.7;margin-bottom:10px;">'+esc(question)+'</div>';
    $('#ask-user-modal').classList.add('open');
    $('#ask-user-reply-input').focus();
  }
  $('#ask-user-reply').addEventListener('click',async function(){
    var text=$('#ask-user-reply-input').value.trim();
    var sid=_pendingAskSid; _pendingAskSid=null;
    $('#ask-user-modal').classList.remove('open');
    $('#ask-user-reply-input').value='';
    if(!sid)return;
    var s=sessions[sid];
    if(text&&s){s.msgs.push({role:'user',text:text});if(sid===activeSid)renderMsg('user',text);}
    try{await call('provide_user_input',sid,text||'ok');startPolling();}catch(e){}
  });
  $('#ask-user-cancel').addEventListener('click',function(){$('#ask-user-modal').classList.remove('open');});
  $('#ask-user-cancel-task').addEventListener('click',async function(){
    var sid=_pendingAskSid;_pendingAskSid=null;
    $('#ask-user-modal').classList.remove('open');
    if(sid){try{await call('stop_task',sid);}catch(e){}}
  });
  $('#ask-user-reply-input').addEventListener('keydown',function(e){
    if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('#ask-user-reply').click();}
  });

  $('#confirm-write-ok').addEventListener('click',async function(){
    var c=_pendingConfirm;_pendingConfirm=null;
    $('#confirm-write-modal').classList.remove('open');
    if(c)try{await call('provide_user_input',c.sid,'__confirm__');startPolling();}catch(e){}
  });
  $('#confirm-write-cancel').addEventListener('click',async function(){
    var c=_pendingConfirm;_pendingConfirm=null;
    $('#confirm-write-modal').classList.remove('open');
    if(c)try{await call('provide_user_input',c.sid,'__cancel__');startPolling();}catch(e){}
  });

  /* ── 思考过程折叠/展开（事件委托）── */
  $('#chat-inner').addEventListener('click',function(e){
    var title=e.target.closest('.th-title');
    if(title){
      var box=title.closest('.thinking-box');
      if(box)box.classList.toggle('collapsed');
    }
  });

  /* ── 设置 ── */
  var THINK_MAP={off:'关',low:'低',med:'中',high:'高'};
  var THINK_REV={'关':'off','低':'low','中':'med','高':'high'};
  function openSettings(){
    loadSettings();
    $('#settings-modal').classList.add('open');
  }
  function loadSettings(){
    // 浏览器宿主（库化 Web 模式）：移动端远程控制是桌面专属能力
    // （get_remote_status 等接口由桌面注入），隐藏该设置区。
    if(window.NORP_HOST==='browser'){
      var rs=$('#remote-settings-section');
      if(rs)rs.style.display='none';
    }
    $('#cfg-language').value=config.language||'zh_CN';
    $('#cfg-close-behavior').value=config.close_button_behavior||'minimize_to_tray';
    $('#cfg-model').innerHTML='<option>'+(config.model||'deepseek-chat')+'</option>';
    $('#cfg-api-base').value=config.api_base||'';
    $('#cfg-project-root').value=config.project_root||'';
    $('#cfg-use-responses').checked=!!config.use_responses_api;
    $('#cfg-think-level').value=THINK_REV[config.think_level]||'high';
    $('#cfg-permission-mode').value=config.permission_mode||'Workspace Write';
    $('#cfg-temperature').value=Math.round((config.temperature||1.0)*10);
    $('#cfg-temperature-val').textContent=(config.temperature||1.0).toFixed(1);
    $('#cfg-max-tokens').value=config.max_tokens||32767;
    $('#cfg-web-search').checked=!!config.enable_web_search;
    $('#cfg-native-confirm-write').checked=config.native_confirm_write!==false;
    $('#cfg-native-confirm-delete').checked=config.native_confirm_delete!==false;
    $('#cfg-native-confirm-exec').checked=!!config.native_confirm_exec;
    $('#cfg-memory').checked=config.memory!==false;
    $('#cfg-memory-mode').value=config.memory_mode||'full';
    $('#cfg-max-rounds').value=config.max_rounds||10;
    $('#cfg-queue-size').value=config.queue_max_size||200;
    $('#cfg-max-steps').value=config.max_steps||128;
    $('#cfg-task-timeout').value=config.task_timeout||0;
    $('#cfg-norp-safe').checked=config.norp_safe_enabled!==false;
    $('#cfg-norp-safe-status').textContent=config.norp_safe_enabled===false?'⚠️ 安全系统已关闭 — 危险操作不再被拦截':'安全系统已启用 — 危险操作将被拦截';
    $('#cfg-jailbreak').checked=config.jailbreak_guard_enabled!==false;
    $('#cfg-jailbreak-action').value=config.jailbreak_guard_action||'block';
    $('#cfg-jailbreak-status').textContent=config.jailbreak_guard_enabled===false?'⚠️ 越狱防护已关闭':'越狱防护已启用 — 恶意注入将被拦截';
    $('#cfg-vision').checked=!!config.vision_enabled;
    $('#cfg-vision-url').value=config.vision_service_url||'';
    $('#cfg-remote-enabled').checked=!!config.remote_enabled;
    $('#cfg-remote-host').value=config.remote_host||'127.0.0.1';
    $('#cfg-remote-port').value=config.remote_port||8090;
    $('#cfg-apikey').value='';
    loadHealth();
  }
  async function saveSettings(){
    // ★ 合并到现有 config（后端 save_config 是整体替换，直接传子集会清掉
    //   plugin_dirs、插件安全配置等未在此面板出现的字段）
    var newCfg=Object.assign({},config||{},{
      language:$('#cfg-language').value,
      close_button_behavior:$('#cfg-close-behavior').value,
      model:$('#cfg-model').value,
      api_base:$('#cfg-api-base').value.trim(),
      use_responses_api:$('#cfg-use-responses').checked,
      project_root:$('#cfg-project-root').value.trim(),
      think_level:THINK_MAP[$('#cfg-think-level').value]||'高',
      permission_mode:$('#cfg-permission-mode').value,
      temperature:parseFloat(($('#cfg-temperature').value/10).toFixed(1)),
      max_tokens:parseInt($('#cfg-max-tokens').value)||32767,
      enable_web_search:$('#cfg-web-search').checked,
      native_confirm_write:$('#cfg-native-confirm-write').checked,
      native_confirm_delete:$('#cfg-native-confirm-delete').checked,
      native_confirm_exec:$('#cfg-native-confirm-exec').checked,
      memory:$('#cfg-memory').checked,
      memory_mode:$('#cfg-memory-mode').value,
      max_rounds:parseInt($('#cfg-max-rounds').value)||10,
      queue_max_size:parseInt($('#cfg-queue-size').value)||200,
      max_steps:parseInt($('#cfg-max-steps').value)||128,
      task_timeout:parseInt($('#cfg-task-timeout').value)||0,
      norp_safe_enabled:$('#cfg-norp-safe').checked,
      jailbreak_guard_enabled:$('#cfg-jailbreak').checked,
      jailbreak_guard_action:$('#cfg-jailbreak-action').value,
      vision_enabled:$('#cfg-vision').checked,
      vision_service_url:$('#cfg-vision-url').value.trim(),
      remote_enabled:$('#cfg-remote-enabled').checked,
      remote_host:$('#cfg-remote-host').value.trim()||'127.0.0.1',
      remote_port:parseInt($('#cfg-remote-port').value)||8090
    });
    try{
      await call('save_config',newCfg);
      config=Object.assign({},config,newCfg);
      var key=$('#cfg-apikey').value.trim();
      if(key){await call('set_api_key',key);}
      syncModelLabels();
      refreshIslands();
      try{var ps=await call('get_plugins');updateFeatureButtons(ps);}catch(e){}
      showToast('设置已保存');
      $('#settings-modal').classList.remove('open');
    }catch(e){
      showToast('保存失败：'+e.message);
    }
  }
  $('#settings-save').addEventListener('click',saveSettings);
  $('#settings-cancel').addEventListener('click',function(){$('#settings-modal').classList.remove('open');});
  $('#settings-x').addEventListener('click',function(){$('#settings-modal').classList.remove('open');});
  $('#settings-modal').addEventListener('click',function(e){if(e.target===this)this.classList.remove('open');});
  $('#settings-restore').addEventListener('click',async function(){
    try{await call('reset_config');config=await call('get_config');loadSettings();syncModelLabels();showToast('已恢复默认设置');}catch(e){showToast('恢复失败');}
  });
  /* ── 输入框选择器（模式 / 模型 popover）── */
  var _pickPop=null;
  var _pickDocHandler=null;
  function closePickPop(){
    if(_pickDocHandler){document.removeEventListener('click',_pickDocHandler,true);_pickDocHandler=null;}
    if(_pickPop){try{_pickPop.remove();}catch(e){}_pickPop=null;}
  }
  function openPickPop(anchor){
    closePickPop();
    var r=anchor.getBoundingClientRect();
    var pop=document.createElement('div');
    pop.className='pick-pop';
    document.body.appendChild(pop);
    // 先挂 DOM 再定位（宽度取决于内容）
    pop.style.top=Math.round(Math.min(r.bottom+6,window.innerHeight-pop.offsetHeight-10))+'px';
    pop.style.left=Math.round(Math.min(Math.max(8,r.left),window.innerWidth-pop.offsetWidth-8))+'px';
    _pickPop=pop;
    _pickDocHandler=function(e){
      if(!pop.contains(e.target)&&!anchor.contains(e.target))closePickPop();
    };
    setTimeout(function(){document.addEventListener('click',_pickDocHandler,true);},0);
    return pop;
  }
  function ppLoading(msg){
    return '<div class="pp-loading">'+esc(msg||'加载中…')+'</div>';
  }
  function isBusy(){
    return _streaming||!!(activeSid&&sessions[activeSid]&&sessions[activeSid].running);
  }
  var MODE_TAG={single:'对话',ptc:'代码组合',custom:'自定义'};
  /* ── 模式选择 ── */
  var _presetsCache=null;
  function toggleModePop(btn){
    if(_pickPop&&_pickPop.getAttribute('data-anchor')===btn.id){closePickPop();return;}
    if(isBusy()){showToast('任务运行中，请先停止再切换模式');return;}
    var pop=openPickPop(btn);
    pop.setAttribute('data-anchor',btn.id);
    pop.innerHTML='<div class="pp-head">模式 <span class="pp-sub">切换立即生效</span></div>'+ppLoading();
    (async function(){
      var ps=_presetsCache;
      try{if(!ps){ps=await call('get_presets');_presetsCache=ps||[];}}catch(e){ps=[];}
      var cur=config.current_preset||config.preset_name||'';
      var listHtml=(ps&&ps.length)?ps.map(function(p){
        var tag=MODE_TAG[p.mode]||p.mode||'';
        return '<div class="pp-item'+(p.name===cur?' active':'')+'" data-mode="'+esc(p.name)+'">'+
          '<div class="ppi-top"><b>'+esc(p.name)+'</b>'+(tag?'<span class="tag-mini">'+esc(tag)+'</span>':'')+'</div>'+
          '<div class="ppi-desc">'+esc(p.description||'')+'</div></div>';
      }).join(''):'<div class="pp-empty">（无可用模式）</div>';
      pop.innerHTML='<div class="pp-head">模式 <span class="pp-sub">切换立即生效</span></div><div class="pp-list">'+listHtml+'</div>';
      Array.prototype.slice.call(pop.querySelectorAll('.pp-item')).forEach(function(el){
        el.addEventListener('click',async function(){
          var name=el.getAttribute('data-mode');
          closePickPop();
          if(name===cur||!name)return;
          config.preset_name=name;
          try{
            await call('save_config',config);
            config=await call('get_config');
            showToast('已切换模式：'+name);
          }catch(e){showToast('切换失败：'+e.message);}
          syncModelLabels();
        });
      });
    })();
  }
  /* ── 模型选择（从 URL 拉取） ── */
  var _modelsCache=null;
  function toggleModelPop(btn){
    if(_pickPop&&_pickPop.getAttribute('data-anchor')===btn.id){closePickPop();return;}
    var pop=openPickPop(btn);
    pop.setAttribute('data-anchor',btn.id);
    renderModelList(pop,false);
  }
  async function renderModelList(pop,forceRefresh){
    var baseUrl=(config&&config.api_base)||'https://api.deepseek.com';
    if(forceRefresh)_modelsCache=null;
    if(!_modelsCache){
      pop.innerHTML='<div class="pp-head">模型</div>'+ppLoading('从 '+esc(baseUrl)+' 拉取中…');
      try{
        var ms=await call('get_models_with_base',baseUrl);
        _modelsCache=(ms&&ms.models)||(Array.isArray(ms)?ms:[])||[];
      }catch(e){_modelsCache=[];}
    }
    var ms=_modelsCache;
    var cur=config.model||'';
    var listHtml=(ms&&ms.length)?ms.map(function(m){
      var name=typeof m==='string'?m:(m.id||m.model||String(m));
      return '<div class="pp-item'+(name===cur?' active':'')+'" data-model="'+esc(name)+'">'+esc(name)+'</div>';
    }).join(''):'<div class="pp-empty">（未拉取到模型，点击下方按钮刷新）</div>';
    pop.innerHTML='<div class="pp-head">模型 <span class="pp-sub">'+esc(baseUrl)+'</span></div>'+
      '<div class="pp-list">'+listHtml+'</div>'+
      '<div class="pp-foot"><button class="pp-btn" data-act="refresh">🔄 从 URL 拉取</button>'+
      '<button class="pp-btn" data-act="settings">⚙️ 模型设置</button></div>';
    Array.prototype.slice.call(pop.querySelectorAll('.pp-item')).forEach(function(el){
      el.addEventListener('click',async function(){
        var name=el.getAttribute('data-model');
        closePickPop();
        if(!name||name===cur)return;
        config.model=name;
        try{
          await call('save_config',config);
          showToast('已切换模型：'+name);
        }catch(e){showToast('切换失败：'+e.message);}
        syncModelLabels();
      });
    });
    var refreshBtn=pop.querySelector('[data-act="refresh"]');
    if(refreshBtn)refreshBtn.addEventListener('click',function(){renderModelList(pop,true);});
    var settingsBtn=pop.querySelector('[data-act="settings"]');
    if(settingsBtn)settingsBtn.addEventListener('click',function(){
      closePickPop();
      openSettings();
      setTimeout(function(){$('#cfg-api-base').focus();},200);
    });
  }
  /* ── 推理强度：下拉选择 ── */
  var THINK_OPTS=[
    {value:'off',label:'关（无推理）'},
    {value:'low',label:'低（快，轻量）'},
    {value:'med',label:'中（标准）'},
    {value:'high',label:'高（深度）'}
  ];
  function toggleThinkPop(btn){
    if(_pickPop&&_pickPop.getAttribute('data-anchor')===btn.id){closePickPop();return;}
    var pop=openPickPop(btn);
    pop.setAttribute('data-anchor',btn.id);
    var cur=config.think_level||'high';
    var listHtml=THINK_OPTS.map(function(o){
      return '<div class="pp-item'+(o.value===cur?' active':'')+'" data-think="'+esc(o.value)+'">'+esc(o.label)+'</div>';
    }).join('');
    pop.innerHTML='<div class="pp-head">推理强度 <span class="pp-sub">切换立即生效</span></div><div class="pp-list">'+listHtml+'</div>';
    Array.prototype.slice.call(pop.querySelectorAll('.pp-item')).forEach(function(el){
      el.addEventListener('click',async function(){
        var v=el.getAttribute('data-think');
        closePickPop();
        if(v===cur)return;
        config.think_level=v;
        try{await call('save_config',config);showToast('推理强度：'+THINK_MAP[v]);}catch(e){showToast('保存失败：'+e.message);}
        syncModelLabels();
      });
    });
  }
  $('#btn-mode').addEventListener('click',function(){toggleModePop(this);});
  $('#home-btn-mode').addEventListener('click',function(){toggleModePop(this);});
  $('#btn-model').addEventListener('click',function(){toggleModelPop(this);});
  $('#home-btn-model').addEventListener('click',function(){toggleModelPop(this);});
  /* ── 权限模式：下拉选择 ── */
  var PERM_OPTS=['Workspace Write','Workspace Read','Full Control','ReadOnly'];
  function togglePermPop(btn){
    if(_pickPop&&_pickPop.getAttribute('data-anchor')===btn.id){closePickPop();return;}
    var pop=openPickPop(btn);
    pop.setAttribute('data-anchor',btn.id);
    var cur=config.permission_mode||'Workspace Write';
    var listHtml=PERM_OPTS.map(function(p){
      return '<div class="pp-item'+(p===cur?' active':'')+'" data-perm="'+esc(p)+'">'+esc(p)+'</div>';
    }).join('');
    pop.innerHTML='<div class="pp-head">权限模式 <span class="pp-sub">切换立即生效</span></div><div class="pp-list">'+listHtml+'</div>';
    Array.prototype.slice.call(pop.querySelectorAll('.pp-item')).forEach(function(el){
      el.addEventListener('click',async function(){
        var v=el.getAttribute('data-perm');
        closePickPop();
        if(v===cur)return;
        config.permission_mode=v;
        try{await call('save_config',config);showToast('权限模式：'+v);}catch(e){showToast('保存失败：'+e.message);}
        syncModelLabels();
      });
    });
  }
  $('#btn-perm').addEventListener('click',function(){togglePermPop(this);});
  $('#home-btn-perm').addEventListener('click',function(){togglePermPop(this);});
  $('#btn-think').addEventListener('click',function(){toggleThinkPop(this);});
  $('#home-btn-think').addEventListener('click',function(){toggleThinkPop(this);});
  /* ── 输入框右上角设置按钮 ── */
  $('#btn-settings-input').addEventListener('click',function(){openSettings();});
  $('#btn-folder').addEventListener('click',async function(){
    try{var p=await call('pick_directory');if(p){$('#cfg-project-root').value=p;config.project_root=p;refreshIslands();showToast('已更改项目根目录');}}catch(e){showToast('无法打开选择器');}
  });
  $('#cfg-temperature').addEventListener('input',function(){
    $('#cfg-temperature-val').textContent=(this.value/10).toFixed(1);
  });
  $('#cfg-getkey').addEventListener('click',function(){showToast('请到平台获取 API Key');});
  $('#cfg-browse').addEventListener('click',async function(){
    try{var p=await call('pick_directory');if(p){$('#cfg-project-root').value=p;}}catch(e){showToast('无法打开选择器');}
  });
  async function refreshModels(){
    var baseUrl=$('#cfg-api-base').value.trim()||config.api_base||'https://api.deepseek.com';
    var btn=$('#cfg-refresh-models');
    if(btn){btn.disabled=true;btn.textContent='⏳ 拉取中…';}
    try{
      var ms=await call('get_models_with_base',baseUrl);
      var models=(ms&&ms.models)||(Array.isArray(ms)?ms:[])||[];
      if(!models.length)models=[config.model||'deepseek-chat'];
      var current=$('#cfg-model').value;
      var opts=models.map(function(m){return '<option>'+(typeof m==='string'?m:(m.id||m.model||m))+'</option>';}).join('');
      $('#cfg-model').innerHTML=opts;
      if(models.some(function(m){return (typeof m==='string'?m:(m.id||m.model||m))===current;})){
        $('#cfg-model').value=current;
      }else if(models.length>0){
        $('#cfg-model').value=models[0];
      }
      showToast('✅ 已加载 '+models.length+' 个模型');
    }catch(e){
      showToast('❌ 拉取失败：'+e.message);
      $('#cfg-model').innerHTML='<option>'+(config.model||'deepseek-chat')+'</option>';
    }finally{
      if(btn){btn.disabled=false;btn.textContent='🔄 刷新模型';}
    }
  }
  $('#cfg-refresh-models').addEventListener('click',refreshModels);
  /* ── 模型变更即时更新 ── */
  $('#cfg-model').addEventListener('change',function(){
    config.model=this.value;
    syncModelLabels();
  });
  function syncModelLabels(){
    var m=config.model||'deepseek-chat';
    $('#model-label').textContent=m;
    $('#home-model-label').textContent=m;
    var tl=THINK_MAP[config.think_level]||config.think_level||'高';
    $('#think-label').textContent=tl;
    $('#home-think-label').textContent=tl;
    var pm=config.current_preset||config.preset_name||'standard';
    $('#mode-label').textContent=pm;
    $('#home-mode-label').textContent=pm;
    var perm=config.permission_mode||'Workspace Write';
    $('#perm-label').textContent=perm;
    $('#home-perm-label').textContent=perm;
  }

  /* ── 运行时健康 ── */
  async function loadHealth(){
    var el=$('#cfg-health-status');
    try{
      var h=await call('get_runtime_health');
      if(h&&typeof h==='object'){
        var fatal=h.fatal_count||0;
        var warn=h.warning_count||0;
        el.textContent=fatal?('⚠️ 检查失败：'+fatal+' 项致命问题'):(warn?('✅ 健康，但有 '+warn+' 项警告'):'✅ 运行时健康');
        el.style.color=fatal?'var(--red)':'';
      }else{
        el.textContent='✅ 运行时健康';
      }
    }catch(e){
      el.textContent='健康检查不可用';
    }
  }
  $('#cfg-health-refresh').addEventListener('click',loadHealth);
  $('#cfg-clear-memory').addEventListener('click',async function(){
    try{await call('clear_memory',activeSid||'');showToast('记忆已清除');}catch(e){showToast('清除失败：'+e.message);}
  });

  /* ── 调试面板 ── */
  async function openDebug(){
    $('#debug-modal').classList.add('open');
    await loadDebug();
  }
  // 调试条目：库 /api/debug 返回键 → 展示标签（条目化渲染，不抛原始 JSON）
  var DEBUG_FIELDS=[
    ['version','版本'],['frontend','前端'],['language','界面语言'],
    ['presets','预设模式'],['models','模型适配器'],['tools','工具'],
    ['plugins','插件'],['sessions','会话数'],['tasks_total','任务总数']
  ];
  async function loadDebug(){
    var rows=$('#debug-rows');
    try{
      var d=await call('get_debug_data');
      d=(d&&typeof d==='object')?d:{};
      var longKeys={presets:1,models:1,tools:1,plugins:1};
      var html='';
      DEBUG_FIELDS.forEach(function(f){
        var key=f[0],label=f[1];
        var v=(d[key]===undefined||d[key]===null)?'—':d[key];
        var shown;
        if(Array.isArray(v)){
          shown=v.length?('<span class="db-count">'+v.length+'</span> '+
            esc(v.slice(0,6).join(', ')+(v.length>6?' …':''))):'—';
        }else{
          shown=esc(String(v));
        }
        html+='<div class="db-row"><span class="db-label">'+label+'</span>'+
          '<span class="db-value">'+shown+'</span></div>';
      });
      rows.innerHTML=html;
      $('#debug-summary').textContent='v'+(d.version||'?')+' · '+(d.frontend||'web')+' · '+
        (Array.isArray(d.sessions)?d.sessions:0)+' 会话 · '+
        (Array.isArray(d.tools)?d.tools.length:0)+' 工具';
      $('#debug-content').textContent=JSON.stringify(d,null,2);
    }catch(e){
      rows.innerHTML='';
      $('#debug-summary').textContent='调试数据不可用';
      $('#debug-content').textContent=e.message||'';
    }
  }
  $('#cfg-debug').addEventListener('click',openDebug);
  $('#debug-x').addEventListener('click',function(){$('#debug-modal').classList.remove('open');});
  $('#debug-modal').addEventListener('click',function(e){if(e.target===this)this.classList.remove('open');});
  $('#debug-refresh').addEventListener('click',loadDebug);
  $('#debug-open-log').addEventListener('click',async function(){
    try{await call('open_debug_log_dir');}catch(e){showToast('无法打开日志目录');}
  });

  /* ── 插件设置（嵌入插件页面）── */
  var ppSec={};
  async function loadPluginPanel(){
    try{
      var sec=await call('get_plugin_security_config');
      if(sec){
        ppSec=sec;
        $('#pp-plugins-enabled').checked=sec.plugins_enabled!==false;
        $('#pp-audit').value=sec.audit||'block';
        $('#pp-import-restrict').value=sec.import_restrict||'strict';
        $('#pp-permissions').checked=sec.require_permissions!==false;
        $('#pp-resource-limit').checked=!!sec.resource_limit;
        $('#pp-isolation').value=sec.isolation||'process';
        $('#pp-signature').checked=sec.signature_verify!==false;
        $('#pp-network-policy').value=sec.network_policy||'deny';
        $('#pp-url-allowlist').value=(sec.network_url_allowlist||[]).join(', ');
        $('#pp-domain-allowlist').value=(sec.network_domain_allowlist||[]).join(', ');
        $('#pp-approval').checked=sec.approval_enabled!==false;
      }
    }catch(e){}
    renderPluginDirs();
  }
  async function renderPluginDirs(){
    try{
      var dirs=await call('get_plugin_dirs');
      var box=$('#pp-dirs');
      box.innerHTML='';
      (dirs||[]).forEach(function(d){
        var row=document.createElement('div');
        row.className='pp-dir';
        row.innerHTML='<span class="pd-path">'+esc(d)+'</span><button class="pd-x">✕</button>';
        row.querySelector('.pd-x').addEventListener('click',async function(){
          try{await call('remove_plugin_dir',d);renderPluginDirs();}catch(e){showToast('移除失败');}
        });
        box.appendChild(row);
      });
      if(!dirs||!dirs.length)box.innerHTML='<div class="hint-text">（暂无插件目录）</div>';
    }catch(e){}
  }
  $('#cfg-open-plugins')&&$('#cfg-open-plugins').addEventListener('click',function(){activateNav('plugins');});
  $('#pp-add-dir').addEventListener('click',async function(){
    try{
      var p=await call('pick_plugin_dir');
      if(!p){showToast('未选择目录');return;}
      await call('add_plugin_dir',p);
      renderPluginDirs();
      showToast('已添加插件目录');
    }catch(e){showToast('添加失败：'+(e.message||e));}
  });
  $('#pp-reload').addEventListener('click',async function(){
    try{
      await call('reload_plugins');
      renderPlugins();
      showToast('🔄 插件已重载');
    }catch(e){showToast('重载失败');}
  });
  $('#pp-save').addEventListener('click',async function(){
    var urlAllowlist=$('#pp-url-allowlist').value.split(',').map(function(s){return s.trim();}).filter(function(s){return s.length>0;});
    var domainAllowlist=$('#pp-domain-allowlist').value.split(',').map(function(s){return s.trim();}).filter(function(s){return s.length>0;});
    try{
      await call('set_plugin_security_config',
        $('#pp-audit').value,$('#pp-import-restrict').value,
        $('#pp-permissions').checked,$('#pp-resource-limit').checked,
        $('#pp-isolation').value,$('#pp-signature').checked,
        (ppSec.trusted_keys||[]),$('#pp-network-policy').value,
        urlAllowlist,domainAllowlist,$('#pp-approval').checked,
        $('#pp-plugins-enabled').checked);
      showToast('插件设置已保存');
      renderPlugins();
      try{var ps=await call('get_plugins');updateFeatureButtons(ps);}catch(e){}
    }catch(e){showToast('保存失败：'+e.message);}
  });

  /* ── 插件显隐 ── */
  var FEATURE_BUTTON_PLUGINS={
    'ssh-btn':'NORP SSH',
    'remote-btn':'NORP SSH',
    'remote-settings-section':'NORP SSH'
  };
  function updateFeatureButtons(list){
    var arr=list||[];
    var loaded={};
    arr.forEach(function(p){if(p&&p.enabled&&!p.error)loaded[p.name]=true;});
    Object.keys(FEATURE_BUTTON_PLUGINS).forEach(function(id){
      var el=document.getElementById(id);
      if(!el)return;
      el.style.display=loaded[FEATURE_BUTTON_PLUGINS[id]]?'':'none';
    });
  }

  /* ── SSH 面板 ── */
  async function openSsh(){
    $('#ssh-modal').classList.add('open');
    await sshRefreshHosts();
  }
  $('#ssh-x').addEventListener('click',function(){$('#ssh-modal').classList.remove('open');});
  async function sshRefreshHosts(){
    try{
      var hosts=await call('ssh_list_hosts','');
      var list=$('#ssh-host-list');
      list.innerHTML='';
      var sel=$('#ssh-exec-host');sel.innerHTML='';
      (hosts||[]).forEach(function(h){
        var item=document.createElement('div');
        item.className='ssh-host-item';
        item.innerHTML='<span class="hh-alias">'+esc(h.alias)+'</span><span class="hh-host">'+esc(h.host||'')+'</span>';
        list.appendChild(item);
        var o=document.createElement('option');o.value=h.alias;o.textContent=h.alias+(h.host?' ('+h.host+')':'');sel.appendChild(o);
      });
      if(!(hosts||[]).length){
        list.innerHTML='<div class="cmd-empty">（暂无主机，可在对话中让 Agent 添加）</div>';
      }
    }catch(e){
      var msg=String(e&&e.message||e);
      $('#ssh-host-list').innerHTML='<div class="cmd-empty">'+(msg.indexOf('方法不存在')!==-1?'SSH 面板仅桌面版可用（库化 Web 模式未提供接口）':'加载失败：'+esc(msg))+'</div>';
    }
  }
  $('#ssh-refresh').addEventListener('click',sshRefreshHosts);
  $('#ssh-import').addEventListener('click',async function(){
    try{var r=await call('ssh_import_config');showToast('导入完成：'+(r&&r.message||''));sshRefreshHosts();}catch(e){showToast('导入失败');}
  });
  $('#ssh-host-search').addEventListener('input',function(){
    var q=this.value.trim().toLowerCase();
    $$('#ssh-host-list .ssh-host-item').forEach(function(it){
      it.style.display=it.textContent.toLowerCase().indexOf(q)!==-1?'':'none';
    });
  });
  $('#ssh-exec-run').addEventListener('click',async function(){
    var alias=$('#ssh-exec-host').value;
    var cmd=$('#ssh-exec-cmd').value.trim();
    if(!alias||!cmd){showToast('请选择主机并输入命令');return;}
    var out=$('#ssh-exec-output');out.style.display='block';out.textContent='执行中…';
    try{
      var r=await call('ssh_exec_cmd',alias,cmd,parseInt($('#ssh-exec-timeout').value)||60);
      out.textContent=(r&&r.stdout||'')+((r&&r.stderr)?('\n[stderr]\n'+r.stderr):'')+((r&&r.error)?('\n[error] '+r.error):'');
    }catch(e){out.textContent='执行失败：'+e.message;}
  });

  /* ── 移动端 ── */
  async function openRemote(){
    $('#remote-modal').classList.add('open');
    var body=$('#remote-body');
    try{
      var st=await call('get_remote_status');
      if(!st||!st.enabled){
        body.innerHTML='<p>📱 移动端远程控制未启用。</p><p style="margin-top:8px;">请在「设置 → 移动端远程控制」勾选启用（绑定 0.0.0.0），保存后重启 NORP。</p>';
        return;
      }
      var ips=(st.lan_ips&&st.lan_ips.length)?st.lan_ips.map(function(i){return (i&&i.ip)||i;}):['127.0.0.1'];
      var first=String(ips[0]||'127.0.0.1');
      var url='http://'+first+':'+(st.port||8090)+'/';
      var html='<p>✅ 远程控制已启用（端口 '+esc(st.port||8090)+'）</p>';
      try{
        var qr=await call('get_remote_qr',url);
        if(qr){
          html+='<div style="text-align:center;margin:12px 0;"><img src="'+qr+'" width="180" height="180" style="border-radius:12px;border:1px solid #e6e8ec;box-shadow:0 4px 14px rgba(16,24,40,.08);"></div>';
        }else{
          html+='<p style="text-align:center;color:#9aa0ab;font-size:12px;margin:10px 0;">（二维码库未安装，请复制下方链接在手机浏览器打开）</p>';
        }
      }catch(e){}
      html+='<p style="text-align:center;font-size:12.5px;color:#5f6672;word-break:break-all;user-select:all;">'+esc(url)+'</p>';
      html+='<p style="font-size:12px;color:#9aa0ab;margin-top:10px;line-height:1.7;">手机浏览器扫码或打开链接即可远程控制当前工作区。<br>⚠️ 暴露到局域网 = 同网段设备可控制你的 Agent。</p>';
      body.innerHTML=html;
    }catch(e){
      var rmsg=String(e&&e.message||e);
      body.innerHTML='<p>'+(rmsg.indexOf('方法不存在')!==-1?'移动端远程控制仅桌面版可用（库化 Web 模式未提供接口）':'获取远程状态失败：'+esc(rmsg))+'</p>';
    }
  }
  $('#remote-x').addEventListener('click',function(){$('#remote-modal').classList.remove('open');});

  /* ── 右侧文件面板 ── */
  var rside=$('#right-side');
  $('#rp-toggle').addEventListener('click',function(){
    var open=rside.classList.toggle('open');
    $('#rp-toggle-icon').innerHTML=open?'<path d="m9 6 6 6-6 6"/>':'<path d="m15 6-6 6 6 6"/>';
  });
  function rpShowTab(tab){
    $$('.rp-tab').forEach(function(x){x.classList.toggle('active',x.getAttribute('data-rtab')===tab)});
    $('#rp-files').classList.toggle('hidden',tab!=='files');
    $('#rp-prev').classList.toggle('hidden',tab!=='preview');
  }
  $$('.rp-tab').forEach(function(t){
    t.addEventListener('click',function(){rpShowTab(t.getAttribute('data-rtab'));});
  });
  function renderFileTree(){
    var tree=$('#rp-tree');
    var root=config.project_root||'工作区';
    tree.innerHTML='<div class="rp-folder open"><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 6 6 6-6 6"/></svg>📁 '+esc(root)+'</div>'+
      '<div class="rp-children">'+
      '<div class="rp-folder"><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 6 6 6-6 6"/></svg>📁 front_src</div>'+
      '<div class="rp-children">'+
      '<div class="rp-file" data-file="index.html"><span class="f-ico">🌐</span>index.html</div>'+
      '<div class="rp-file" data-file="core.js"><span class="f-ico">🟨</span>core.js</div>'+
      '<div class="rp-file" data-file="styles.css"><span class="f-ico">🎨</span>styles.css</div>'+
      '<div class="rp-file" data-file="main.js"><span class="f-ico">🟨</span>main.js</div>'+
      '</div>'+
      '<div class="rp-file" data-file="api.py"><span class="f-ico">🐍</span>api.py</div>'+
      '<div class="rp-file" data-file="main.py"><span class="f-ico">🐍</span>main.py</div>'+
      '<div class="rp-file" data-file="README.md"><span class="f-ico">📝</span>README.md</div>'+
      '<div class="rp-file" data-file="front.html"><span class="f-ico">🌐</span>front.html</div>'+
      '</div>';
    $$('#rp-tree .rp-folder').forEach(function(f){
      f.addEventListener('click',function(){f.classList.toggle('open');});
    });
    $$('#rp-tree .rp-file').forEach(function(f){
      f.addEventListener('click',function(){openFilePreview(f.getAttribute('data-file'));});
    });
  }
  var FILE_PREVIEWS={
    'index.html':'（文件预览为演示内容）\n\n<!DOCTYPE html>\n<html lang="zh-CN">\n  <head>…</head>\n  <body>…</body>\n</html>',
    'core.js':'// 核心渲染与事件处理\nfunction handleEvent(ev){…}',
    'styles.css':'/* 设计令牌 */\n:root{--accent:#007aff;…}',
    'main.js':'// 入口\nwindow.addEventListener("pywebviewready", init);',
    'api.py':'class AgentAPI:\n    def send_message(self, sid, text):\n        …',
    'main.py':'import webview\nwebview.start()',
    'README.md':'# NORP Agent\n\n自主 AI 编码助手。',
    'front.html':'（打包产物，由 build_front.py 生成）'
  };
  function openFilePreview(name){
    $('#rp-prev-title').textContent=name;
    $('#rp-prev-body').textContent=FILE_PREVIEWS[name]||('// '+name+'\n（演示文件）');
    rpShowTab('preview');
  }
  $('#rp-prev-x').addEventListener('click',function(){rpShowTab('files');});
  $('#rp-search-input').addEventListener('input',function(){
    var q=this.value.trim().toLowerCase();
    $$('#rp-tree .rp-file').forEach(function(f){
      f.style.display=(!q||f.getAttribute('data-file').toLowerCase().indexOf(q)!==-1)?'':'none';
    });
  });

  /* ── 技能 / 插件 / 消息 ── */
  var SKILLS=[
    {icon:'💻',name:'代码开发',desc:'读写文件、执行命令、跑测试，自主完成编码任务。'},
    {icon:'📄',name:'文档处理',desc:'生成/改写 Markdown、Word、PDF，提取与排版。'},
    {icon:'🔍',name:'深度研究',desc:'联网检索、多源交叉验证，输出结构化研究报告。'},
    {icon:'📊',name:'数据分析',desc:'读取 CSV/Excel，统计、绘图、生成结论。'},
    {icon:'👁️',name:'图片理解',desc:'OCR 与界面分析，接入视觉模型识别截图。'},
    {icon:'🔌',name:'SSH 运维',desc:'远程主机管理、命令执行、隧道与集群运维。'},
    {icon:'🐙',name:'Git 工作流',desc:'状态/日志/提交/推送，可视化提交图。'},
    {icon:'🎬',name:'视频生成',desc:'文生视频、脚本编排、自动渲染。'}
  ];
  function renderSkills(){
    var g=$('#skill-grid');
    if(g.innerHTML)return;
    g.innerHTML=SKILLS.map(function(s){
      return '<div class="skill-card"><div class="sk-top"><span class="sk-icon">'+s.icon+'</span><span class="sk-name">'+s.name+'</span></div><div class="sk-desc">'+s.desc+'</div></div>';
    }).join('');
  }
  async function renderPlugins(){
    try{
      var ps=await call('get_plugins');
      var list=$('#plugin-list');
      $('#plugin-sub').textContent=(ps||[]).length+' 个已安装';
      if(!ps||!ps.length){list.innerHTML='<div class="empty">（暂无插件）</div>';}
      else{
        list.innerHTML=(ps||[]).map(function(p){
          var sig=p.signature_status==='trusted'?'<span class="tag-mini tag-blue">🔏 已签名</span>':'';
          var err=p.error?'<span class="tag-mini tag-orange">'+esc(p.error)+'</span>':'';
          return '<div class="plugin-item"><span class="pl-icon">🔌</span><div class="pl-body">'+
            '<div class="pl-name">'+esc(p.name)+' <span class="pl-ver">v'+esc(p.version||'0.0.0')+'</span></div>'+
            '<div class="pl-desc">'+esc(p.description||'')+'</div>'+
            '<div class="pl-meta">'+sig+'<span class="tag-mini tag-green">'+(p.tool_count||0)+' 个工具</span>'+err+'</div></div></div>';
        }).join('');
      }
      updateFeatureButtons(ps);
    }catch(e){}
    loadPluginPanel();
  }
  function renderMessages(){
    var list=$('#msg-list');
    if(list.innerHTML)return;
    list.innerHTML='<div class="empty"><div class="e-icon">📨</div><p>暂无消息<br><span style="font-size:11px;color:#9aa0ab;">任务完成、SSH 异常等通知会出现在这里</span></p></div>';
  }
  $$('[data-act]').forEach(function(b){
    b.addEventListener('click',function(){
      var a=b.getAttribute('data-act');
      if(a==='reload-plugins'){renderPlugins();showToast('🔄 插件列表已刷新');}
      else if(a==='new-rule'){showToast('规则创建器即将开放（演示）');}
    });
  });

  /* ── 搜索任务 ── */
  $('#search-input').addEventListener('input',function(){
    var q=this.value.trim().toLowerCase();
    $$('#task-list .island').forEach(function(isl){
      var title=(isl.querySelector('.is-title')||{}).textContent||'';
      isl.style.display=title.toLowerCase().indexOf(q)!==-1?'':'none';
    });
  });

  /* ── 初始化（main.js 调用）── */
  window.NorpInit=async function(){
    config=await call('get_config');
    syncModelLabels();
    refreshModels();
    $('#status-workspace').textContent=config.project_root||'—';
    $('#workspace-display').innerHTML='<span class="w-dot"></span>'+esc(config.project_root||'—');
    try{
      var b=await call('get_balance');
      $('#balance-val').textContent=fmtBalance(b);
    }catch(e){$('#balance-val').textContent='—';}
    try{var ps=await call('get_plugins');updateFeatureButtons(ps);}catch(e){}
    try{
      var ss=await call('get_sessions');
      (ss||[]).forEach(function(x){
        if(x&&x.id&&!sessions[x.id]){
          sessions[x.id]={title:x.title||'任务',hasTask:!!x.has_task,running:!!x.running,msgs:[],cmds:[],tokens:{}};
        }
      });
    }catch(e){}
    if(!Object.keys(sessions).length){
      try{
        var sid=await call('create_session',config.project_root||'');
        sessions[sid]={title:'新任务',hasTask:false,running:false,msgs:[],cmds:[],tokens:{}};
        activeSid=sid;
      }catch(e){}
    }else{
      activeSid=Object.keys(sessions)[0];
      try{
        var hist=await call('get_initial_messages',activeSid);
        (hist||[]).forEach(function(m){
          if(m&&m.role){
            sessions[activeSid].msgs.push({role:m.role==='assistant'?'assistant':'user',text:m.content||m.text||''});
          }
        });
      }catch(e){}
      _idleSyncCount=sessions[activeSid].msgs.length;
    }
    refreshIslands();
    renderFileTree();
    var first=false;
    try{first=await call('is_first_run');}catch(e){}
    if(first){
      setTimeout(openSettings,400);
    }else{
      try{
        var hasKey=await call('has_api_key');
        if(!hasKey)setTimeout(openSettings,500);
      }catch(e){}
    }
    var lo=$('#loading-overlay');
    if(lo)lo.style.display='none';
    setStatus('就绪');
    if(activeSid)startPolling();
  };

  function fmtBalance(b){
    if(b==null)return '—';
    if(typeof b==='number')return '¥ '+b.toFixed(2);
    if(typeof b==='object'){
      // DeepSeek 官方格式：{balance_infos:[{total_balance, granted_balance, topped_up_balance, currency}]}
      if(b.balance_infos&&b.balance_infos.length){
        var info=b.balance_infos[0];
        var cur=(info.currency||'CNY').toUpperCase();
        var sym=cur==='USD'?'$':(cur==='CNY'?'¥':(cur+' '));
        var total=parseFloat(info.total_balance);
        if(!isNaN(total))return sym+total.toFixed(2);
      }
      if(b.error)return '—';
      var v=b.balance!=null?b.balance:(b.amount!=null?b.amount:(b.value!=null?b.value:null));
      if(v!=null)return '¥ '+(typeof v==='number'?v.toFixed(2):v);
      return '—';
    }
    return String(b);
  }
})();


// ═══════════════════════════════════════════════════════════════
//  NORP Agent 新前端 — MAIN（入口）
// ═══════════════════════════════════════════════════════════════
/* NORP Agent 新前端 · 入口
   Copyright (c) 2026 xbm666, MIT Licensed */
window.addEventListener('pywebviewready', async function(){
  var statusEl=document.getElementById('loadingStatusText');
  var progEl=document.getElementById('loadingProgress');
  function prog(t){if(progEl)progEl.textContent=t;}
  function fatal(title,details){
    if(statusEl)statusEl.textContent=title;
    var det=document.getElementById('loadingErrorDetails');
    if(det&&details)det.textContent=details;
    var btn=document.getElementById('loadingExitBtn');
    if(btn)btn.style.display='inline-block';
  }
  // 桌面（pywebview）：走 loading_ready；库化 Web 模式（桥接）：引擎已就绪，直接初始化。
  var isWeb = !(window.pywebview && window.pywebview.api && typeof window.pywebview.api.loading_ready === 'function');
  try{
    if(!isWeb){
      prog('正在初始化后端…');
      var r=await window.pywebview.api.loading_ready();
      if(r&&r.status==='error'){
        fatal(r.title||'启动失败',r.details||'');
        var badge=document.getElementById('loadingFatalBadge');
        if(badge)badge.textContent='('+(r.fatal_count||1)+')';
        return;
      }
    }
  }catch(e){
    // loading_ready 不可用（库化 Web 模式或桥未实现）：继续尝试初始化
  }
  try{if(window.pywebview.api&&typeof window.pywebview.api.dismiss_splash==='function')await window.pywebview.api.dismiss_splash();}catch(e){}
  try{
    prog('正在加载前端…');
    await window.NorpInit();
  }catch(e){
    fatal('初始化失败',e.message||String(e));
  }
});

</script>
<script>
// ═══════════════════════════════════════════════════════════════
//  BRIDGE — 多宿主传输桥（作者 xingluosama121 的库化桥接代码）
//  pywebview 桌面：window.pywebview.api 已存在 → 原样使用；
//  浏览器宿主（norpagent 库 WebUI 以 HTTP+SSE 提供本页面）：
//  构造 window.pywebview.api，并把库事件翻译为 T:/R:/C:/U:/E:/Q:/D: 文本事件。
// ═══════════════════════════════════════════════════════════════
//  BRIDGE — Multi-host transport (pywebview / library HTTP+SSE)
// ═══════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════
//  BRIDGE — 多宿主传输桥（库化支持）
// ═══════════════════════════════════════════════════════════════
// 检测宿主环境：
//   - pywebview 桌面宿主：window.pywebview.api 已存在 → 原样使用；
//   - 浏览器宿主（norpagent 库 WebUI 以 HTTP 提供本页面）：
//     本文件构造 window.pywebview.api，用 fetch + SSE 实现全部方法，
//     并把库事件（JSON）翻译为 front.html 的文本事件协议
//     （T: 思考 / R: 回复 / C: 工具 / U: 用量 / E: 错误 / Q: 提问 / D: 直达）。
// 前端其余代码零改动即可在两种宿主下运行。

(function() {
    // 桌面宿主：pywebview 注入已存在 → 不接管
    if (window.pywebview && window.pywebview.api) {
        return;
    }

    var API_BASE = '';
    var _queues = {};        // sid -> [event string]
    var _finished = {};      // sid -> true（流结束）
    var _streamAcc = {};     // sid -> 已流式累积的正文
    var _pendingQuestion = {}; // sid -> question_id
    var _configCache = null;
    var _maxQueue = 500;

    function _sleep(ms) {
        return new Promise(function(resolve) { setTimeout(resolve, ms); });
    }

    function _push(sid, text) {
        if (!sid) return;
        var q = _queues[sid] || (_queues[sid] = []);
        q.push(text);
        while (q.length > _maxQueue) q.shift();
    }

    function _finish(sid) {
        if (!sid) return;
        _finished[sid] = true;
        delete _streamAcc[sid];
    }

    function _slice(text, n) {
        if (text === null || text === undefined) return '';
        var s = String(text);
        return s.length > n ? s.substring(0, n) + '...' : s;
    }

    // ── HTTP 封装 ────────────────────────────────────────────
    async function http(method, path, body) {
        var opts = { method: method, headers: {} };
        if (body !== undefined && body !== null) {
            opts.headers['Content-Type'] = 'application/json';
            opts.body = JSON.stringify(body);
        }
        var resp;
        try {
            resp = await fetch(API_BASE + path, opts);
        } catch (e) {
            throw new Error('failed to fetch: ' + (e && e.message ? e.message : e));
        }
        var text = await resp.text();
        var data = null;
        try { data = text ? JSON.parse(text) : {}; } catch (e) { data = {}; }
        if (!resp.ok) {
            throw new Error((data && (data.error || data.message)) ||
                ('HTTP ' + resp.status));
        }
        return data;
    }

    // ── 库事件 → 前端协议翻译 ────────────────────────────────
    function handleServerItem(item) {
        if (!item) return;
        var type = item.type || '';
        var sid = item.sid || '';
        switch (type) {
            case 'on_content': {
                var content = item.content || '';
                if (item.stream) {
                    _streamAcc[sid] = (_streamAcc[sid] || '') + content;
                    _push(sid, 'R:' + content);
                } else {
                    var acc = _streamAcc[sid];
                    if (acc === undefined || acc.trim() !== content.trim()) {
                        _push(sid, 'R:' + content);
                    }
                    delete _streamAcc[sid];
                }
                break;
            }
            case 'on_reasoning': {
                var r = item.reasoning || item.content || '';
                if (r) _push(sid, 'T:' + r);
                break;
            }
            case 'before_tool_call':
                _push(sid, 'C:' + JSON.stringify({
                    tool: item.tool_name || 'tool',
                    args: item.args || {}
                }));
                break;
            case 'after_tool_call':
                _push(sid, 'C:' + JSON.stringify({
                    tool: item.tool_name || 'tool',
                    args: item.args || {},
                    result: _slice(item.result, 400)
                }));
                break;
            case 'on_tool_error':
                _push(sid, 'C:' + JSON.stringify({
                    tool: item.tool_name || 'tool',
                    args: item.args || {},
                    error: _slice(item.error, 400)
                }));
                break;
            case 'on_usage_update':
                _push(sid, 'U:' + JSON.stringify({
                    input_tokens: item.input || 0,
                    output_tokens: item.output || 0,
                    tool_call_tokens: item.tool_call_tokens || 0
                }));
                break;
            case 'on_task_done':
                _finish(sid);
                break;
            case 'on_task_error':
                _push(sid, 'E:' + (item.error || 'task error'));
                _finish(sid);
                break;
            case 'on_task_stopped':
                _push(sid, 'E:' + (item.reason || item.error || 'task stopped'));
                _finish(sid);
                break;
            case 'on_task_timeout':
                _push(sid, 'E:task timeout ' + (item.timeout || ''));
                _finish(sid);
                break;
            case 'question': {
                var qid = item.question_id || '';
                if (sid && qid) _pendingQuestion[sid] = qid;
                _push(sid, 'Q:' + JSON.stringify(item.question || ''));
                break;
            }
            case 'notify':
                if (item.level === 'error' && sid) {
                    _push(sid, 'E:' + (item.message || 'error'));
                }
                break;
            case 'on_task_start':
                // 用户消息已由前端本地渲染；仅清空该会话旧的累积状态
                delete _streamAcc[sid];
                break;
            default:
                break; // 钩子内部事件（before_step 等）不渲染
        }
    }

    function connectSSE() {
        var es;
        try {
            es = new EventSource(API_BASE + '/events');
        } catch (e) {
            // EventSource 不可用：降级为静默轮询（极少见）
            setInterval(function() {
                http('GET', '/api/status').catch(function() {});
            }, 5000);
            return;
        }
        es.onmessage = function(msg) {
            var item = null;
            try { item = JSON.parse(msg.data); } catch (e) { return; }
            handleServerItem(item);
        };
        es.onerror = function() {
            // EventSource 自动重连；无需额外处理
        };
    }

    // ── window.pywebview.api（浏览器实现） ─────────────────────
    var api = {};

    api.loading_ready = async function() {
        try {
            var st = await http('GET', '/api/status');
            return { status: 'ok', details: '' };
        } catch (e) {
            throw new Error('无法连接到后端服务: ' + (e.message || e));
        }
    };

    api.dismiss_splash = async function() { return true; };

    api.is_first_run = async function() {
        var d = await http('GET', '/api/first_run');
        return !!d.first_run;
    };

    api.has_api_key = async function() {
        var d = await http('GET', '/api/config');
        return !!d.has_api_key;
    };

    api.get_config = async function() {
        var d = await http('GET', '/api/config');
        _configCache = d;
        return d;
    };

    api.save_config = async function(cfg) {
        var d = await http('POST', '/api/config', { config: cfg || {} });
        _configCache = d.config || d;
        return _configCache;
    };

    api.reset_config = async function() {
        var d = await http('POST', '/api/config/reset', {});
        _configCache = d.config || d;
        return _configCache;
    };

    api.set_api_key = async function(key) {
        var d = await http('POST', '/api/key', { api_key: key || '' });
        return d.ok ? 'ok' : 'error:' + (d.error || 'save failed');
    };

    api.validate_api_key = async function(key, baseUrl) {
        try {
            var d = await http('POST', '/api/key/validate', {
                api_key: key || '', base_url: baseUrl || ''
            });
            if (d.ok) return 'ok';
            return 'error:' + (d.error || 'invalid api key');
        } catch (e) {
            return 'error:' + (e.message || e);
        }
    };

    api.create_session = async function(workspace) {
        var d = await http('POST', '/api/sessions', {
            title: '', workspace: workspace || ''
        });
        if (d.id) return d.id;
        return 'error:' + (d.error || 'create failed');
    };

    api.get_sessions = async function() {
        var d = await http('GET', '/api/sessions');
        return d.sessions || [];
    };

    api.close_session = async function(sid) {
        await http('DELETE', '/api/sessions/' + encodeURIComponent(sid || ''), {});
        delete _queues[sid]; delete _finished[sid]; delete _streamAcc[sid];
        return true;
    };

    api.set_session_title = async function(sid, title) {
        await http('POST', '/api/sessions/' + encodeURIComponent(sid || '') + '/title',
            { title: title || '' });
        return true;
    };

    api.set_session_workspace = async function(sid, ws) {
        await http('POST', '/api/sessions/' + encodeURIComponent(sid || '') + '/workspace',
            { workspace: ws || '' });
        return true;
    };

    api.get_initial_messages = async function(sid) {
        var d = await http('GET', '/api/sessions/' + encodeURIComponent(sid || '') + '/messages');
        return d.messages || [];
    };

    api.get_memory_content = async function(sid) {
        try {
            var d = await http('GET', '/api/memory?session_id=' + encodeURIComponent(sid || ''));
            return d.content || null;
        } catch (e) { return null; }
    };

    api.clear_memory = async function(sid) {
        await http('POST', '/api/memory/clear', { session_id: sid || '' });
        return { ok: true };
    };

    api.send_message = async function(sid, text) {
        delete _queues[sid]; delete _finished[sid]; delete _streamAcc[sid];
        var d = await http('POST', '/chat', { prompt: text || '', session_id: sid || '' });
        if (!d.ok) return 'error:' + (d.error || 'send failed');
        return 'ok';
    };

    api.get_next_event = async function(sid) {
        var q = _queues[sid];
        if (q && q.length) return q.shift();
        if (_finished[sid]) {
            delete _finished[sid];
            delete _streamAcc[sid];
            return null; // 流结束
        }
        await _sleep(45);
        return 'WAIT';
    };

    api.stop_task = async function(sid) {
        try {
            await http('POST', '/stop', { session_id: sid || '' });
        } catch (e) { /* 后端已停止时忽略 */ }
        _finish(sid);
        return true;
    };

    api.provide_user_input = async function(sid, text) {
        var qid = _pendingQuestion[sid] || '';
        delete _pendingQuestion[sid];
        await http('POST', '/answer', {
            question_id: qid, session_id: sid || '', answer: text || ''
        });
        return true;
    };

    api.upload_files = async function(files) {
        var d = await http('POST', '/api/upload', { files: files || [] });
        return d.files || [];
    };

    api.get_models_with_base = async function(baseUrl) {
        var d = await http('GET', '/api/models?base_url=' + encodeURIComponent(baseUrl || ''));
        if (d.error) return { error: d.error };
        return d.models || [];
    };

    api.get_presets = async function() {
        var d = await http('GET', '/api/presets');
        return d.presets || [];
    };

    api.get_balance = async function() {
        try {
            var d = await http('GET', '/api/balance');
            return d || { balance: null };
        } catch (e) { return { balance: null, error: e.message || '' }; }
    };

    api.get_total_usage = async function(sid) {
        try {
            var d = await http('GET', '/api/usage');
            return {
                input_tokens: d.input_tokens || 0,
                output_tokens: d.output_tokens || 0,
                tool_call_tokens: d.tool_call_tokens || 0
            };
        } catch (e) { return null; }
    };

    api.get_runtime_health = async function() {
        try {
            var d = await http('GET', '/api/health');
            return d;
        } catch (e) { return { status: 'unknown', error: e.message || '' }; }
    };

    api.get_debug_data = async function() {
        try {
            return await http('GET', '/api/debug');
        } catch (e) { return {}; }
    };

    api.open_debug_log_dir = async function() {
        // 桌面前端以字符串 'error:...' 判定失败
        return 'error:browser host: not supported';
    };

    // ── 插件 ────────────────────────────────────────────────
    api.get_plugins = async function() {
        var d = await http('GET', '/api/plugins');
        return d.plugins || [];
    };

    api.get_plugin_dirs = async function() {
        var d = await http('GET', '/api/plugins/dirs');
        return d.dirs || [];
    };

    api.add_plugin_dir = async function(path) {
        var d = await http('POST', '/api/plugins/dirs', { path: path || '' });
        return d.dirs || [];
    };

    api.remove_plugin_dir = async function(path) {
        var d = await http('DELETE', '/api/plugins/dirs', { path: path || '' });
        return d.dirs || [];
    };

    api.reload_plugins = async function() {
        var d = await http('POST', '/api/plugins/reload', {});
        return d.plugins || [];
    };

    api.get_plugin_security_config = async function() {
        var d = await http('GET', '/api/security');
        return d;
    };

    api.set_plugin_security_config = async function() {
        // 桌面前端以 12 个位置参数调用（audit, import_restrict, ...）
        var args = Array.prototype.slice.call(arguments);
        var d = await http('POST', '/api/security', { security_args: args });
        return d;
    };

    api.set_norp_safe_enabled = async function(on) {
        var d = await http('POST', '/api/security', { norp_safe_enabled: !!on });
        return d;
    };

    // ── 目录 / 文件选择框（浏览器宿主：服务端导航的模态框） ─────
    // 浏览器出于安全策略不会暴露本地绝对路径，因此选择框由后端
    // （/api/fs/list 只读列举）提供导航数据，前端模态框渲染，
    // 返回给后端的仍是真实绝对路径。
    var _fsPickerState = null;

    function _fsList(path, includeFiles) {
        var q = '/api/fs/list?path=' + encodeURIComponent(path || '');
        if (includeFiles) q += '&files=1';
        return http('GET', q).catch(function(e) {
            return { ok: false, error: (e && e.message) || 'list failed',
                     dirs: [], files: [], path: path || '' };
        });
    }

    function _fsPickerEnsureDom() {
        var root = document.getElementById('np-fs-picker');
        if (root) return root;
        root = document.createElement('div');
        root.id = 'np-fs-picker';
        root.innerHTML =
            '<style>' +
            '#np-fs-picker{position:fixed;inset:0;z-index:1000000;display:none;}' +
            '#np-fs-picker .npfs-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.55);}' +
            '#np-fs-picker .npfs-panel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);' +
            'width:min(560px,92vw);max-height:80vh;display:flex;flex-direction:column;' +
            'background:#111827;border:1px solid #374151;border-radius:10px;' +
            'box-shadow:0 16px 48px rgba(0,0,0,.5);overflow:hidden;font-family:system-ui,sans-serif;}' +
            '#np-fs-picker .npfs-title{padding:12px 16px;font-size:14px;font-weight:600;' +
            'color:#e5e7eb;border-bottom:1px solid #1f2937;background:#0b1220;}' +
            '#np-fs-picker .npfs-path{margin:10px 12px 4px;padding:8px 10px;font-size:13px;' +
            'color:#e5e7eb;background:#1f2937;border:1px solid #374151;border-radius:6px;}' +
            '#np-fs-picker .npfs-tools{display:flex;gap:6px;padding:4px 12px;}' +
            '#np-fs-picker .npfs-tools button{padding:4px 10px;font-size:12px;color:#9ca3af;' +
            'background:#1f2937;border:1px solid #374151;border-radius:6px;cursor:pointer;}' +
            '#np-fs-picker .npfs-tools button:hover{color:#e5e7eb;border-color:#4b5563;}' +
            '#np-fs-picker .npfs-list{flex:1;overflow-y:auto;padding:6px 12px;min-height:180px;}' +
            '#np-fs-picker .npfs-entry{padding:7px 10px;font-size:13px;color:#d1d5db;' +
            'border-radius:6px;cursor:pointer;white-space:nowrap;overflow:hidden;' +
            'text-overflow:ellipsis;}' +
            '#np-fs-picker .npfs-entry:hover{background:#1f2937;color:#fff;}' +
            '#np-fs-picker .npfs-entry.npfs-selected{background:#1e3a5f;color:#fff;}' +
            '#np-fs-picker .npfs-error{color:#f87171;cursor:default;}' +
            '#np-fs-picker .npfs-empty{color:#6b7280;cursor:default;text-align:center;padding:24px;}' +
            '#np-fs-picker .npfs-actions{display:flex;justify-content:flex-end;gap:8px;' +
            'padding:10px 12px;border-top:1px solid #1f2937;background:#0b1220;}' +
            '#np-fs-picker .npfs-actions button{padding:7px 18px;font-size:13px;border-radius:6px;' +
            'cursor:pointer;border:1px solid #374151;background:#1f2937;color:#e5e7eb;}' +
            '#np-fs-picker .npfs-actions button.npfs-primary{background:#2563eb;border-color:#2563eb;color:#fff;}' +
            '</style>' +
            '<div class="npfs-backdrop"></div>' +
            '<div class="npfs-panel">' +
            '  <div class="npfs-title"></div>' +
            '  <input class="npfs-path" spellcheck="false">' +
            '  <div class="npfs-tools">' +
            '    <button data-npfs="up">..</button>' +
            '    <button data-npfs="home">~</button>' +
            '  </div>' +
            '  <div class="npfs-list"></div>' +
            '  <div class="npfs-actions">' +
            '    <button data-npfs="ok" class="npfs-primary"></button>' +
            '    <button data-npfs="cancel"></button>' +
            '  </div>' +
            '</div>';
        document.body.appendChild(root);
        var closeBtn = root.querySelector('[data-npfs="cancel"]');
        closeBtn.addEventListener('click', function() { _fsPickerDone(null); });
        var backdrop = root.querySelector('.npfs-backdrop');
        backdrop.addEventListener('click', function() { _fsPickerDone(null); });
        var okBtn = root.querySelector('[data-npfs="ok"]');
        okBtn.addEventListener('click', function() {
            var st = _fsPickerState;
            if (!st) return;
            if (st.mode === 'file') {
                _fsPickerDone(st.selected);
            } else {
                _fsPickerDone(st.cwd || st.home);
            }
        });
        var upBtn = root.querySelector('[data-npfs="up"]');
        upBtn.addEventListener('click', function() {
            var st = _fsPickerState;
            if (!st) return;
            _fsList(st.cwd, st.mode === 'file').then(function(d) {
                if (d.ok && d.parent) {
                    _fsPickerNavigate(d.parent);
                } else if (d.ok) {
                    _fsPickerNavigate('');  // 已在根：回主目录 / 盘符视图
                }
            });
        });
        var homeBtn = root.querySelector('[data-npfs="home"]');
        homeBtn.addEventListener('click', function() {
            var st = _fsPickerState;
            if (st) _fsPickerNavigate(st.home || '');
        });
        var pathEl = root.querySelector('.npfs-path');
        pathEl.addEventListener('keydown', function(e) {
            if (e.key !== 'Enter') return;
            var v = pathEl.value.trim();
            if (!v) return;
            if (_fsPickerState && _fsPickerState.mode === 'file') {
                _fsList(v, true).then(function(d) {
                    if (d.ok && d.path) {
                        _fsPickerRender(d);
                    } else if (d.ok === false && _fsPickerState) {
                        // 列举失败：当作已输入的文件路径（选择后由后端校验）
                        _fsPickerState.selected = v;
                        _fsPickerState.cwd = v;
                    }
                });
            } else {
                _fsPickerNavigate(v);
            }
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && root.style.display === 'block') {
                _fsPickerDone(null);
            }
        });
        return root;
    }

    function _fsPickerDone(val) {
        var st = _fsPickerState;
        var root = document.getElementById('np-fs-picker');
        if (root) root.style.display = 'none';
        if (st && st.resolve) {
            var cb = st.resolve;
            _fsPickerState = null;
            cb(val);
        }
    }

    function _fsPickerNavigate(path) {
        var st = _fsPickerState;
        if (!st) return;
        _fsList(path, st.mode === 'file').then(_fsPickerRender);
    }

    function _fsPickerRender(d) {
        var st = _fsPickerState;
        if (!st) return;
        var root = document.getElementById('np-fs-picker');
        if (!root) return;
        var listEl = root.querySelector('.npfs-list');
        var pathEl = root.querySelector('.npfs-path');
        listEl.innerHTML = '';
        if (!d.ok) {
            var err = document.createElement('div');
            err.className = 'npfs-entry npfs-error';
            err.textContent = d.error || 'list failed';
            listEl.appendChild(err);
            return;
        }
        if (d.path) st.cwd = d.path;
        if (d.home) st.home = d.home;
        pathEl.value = st.cwd;
        var add = function(label, path, isDir, filePath) {
            var el = document.createElement('div');
            el.className = 'npfs-entry';
            el.textContent = label;
            if (filePath && st.mode === 'file' && filePath === st.selected) {
                el.classList.add('npfs-selected');
            }
            el.addEventListener('click', function() {
                if (isDir) {
                    _fsPickerNavigate(path);
                } else if (st.mode === 'file') {
                    st.selected = filePath;
                    pathEl.value = filePath;
                    listEl.querySelectorAll('.npfs-entry').forEach(function(x) {
                        x.classList.remove('npfs-selected');
                    });
                    el.classList.add('npfs-selected');
                }
            });
            if (!isDir && st.mode === 'file') {
                el.addEventListener('dblclick', function() {
                    _fsPickerDone(filePath);
                });
            }
            listEl.appendChild(el);
        };
        var useT2 = (typeof t === 'function');
        var lbDrive = useT2 ? t('picker_drive') : 'Drive';
        var lbDir = useT2 ? t('picker_dir') : 'Folder';
        var lbFile = useT2 ? t('picker_file') : 'File';
        (d.drives || []).forEach(function(x) {
            add('[' + lbDrive + '] ' + x.name, x.path, true, null);
        });
        (d.dirs || []).forEach(function(x) {
            add('[' + lbDir + '] ' + x.name + '/', x.path, true, null);
        });
        (d.files || []).forEach(function(x) {
            add('[' + lbFile + '] ' + x.name, x.path, false, x.path);
        });
        if (!(d.drives || []).length && !(d.dirs || []).length &&
            !(d.files || []).length) {
            var empty = document.createElement('div');
            empty.className = 'npfs-entry npfs-empty';
            empty.textContent = '...';
            listEl.appendChild(empty);
        }
    }

    function _fsPickerOpen(mode, startPath) {
        var root = _fsPickerEnsureDom();
        var useT = (typeof t === 'function');
        root.querySelector('.npfs-title').textContent =
            useT ? (t(mode === 'file' ? 'picker_choose_file' : 'picker_choose_dir')) :
            (mode === 'file' ? 'Choose File' : 'Choose Directory');
        root.querySelector('[data-npfs="up"]').textContent =
            useT ? t('picker_up') : 'Up';
        root.querySelector('[data-npfs="home"]').textContent =
            useT ? t('picker_home') : 'Home';
        root.querySelector('[data-npfs="ok"]').textContent =
            useT ? t('picker_ok') : 'Select';
        root.querySelector('[data-npfs="cancel"]').textContent =
            useT ? t('cancel') : 'Cancel';
        root.querySelector('.npfs-path').placeholder =
            useT ? t('picker_path_placeholder') : 'Type a path and press Enter';
        return new Promise(function(resolve) {
            _fsPickerState = {
                mode: mode, cwd: '', home: '', selected: null, resolve: resolve,
            };
            root.style.display = 'block';
            _fsList(startPath || '', mode === 'file').then(function(d) {
                if (_fsPickerState) _fsPickerRender(d);
            });
        });
    }

    // ── 桌面专属能力：浏览器降级 ─────────────────────────────
    api.pick_directory = async function() {
        return _fsPickerOpen('dir', '');
    };

    api.pick_file = async function(filter) {
        return _fsPickerOpen('file', '');
    };

    api.pick_plugin_dir = async function() {
        return _fsPickerOpen('dir', '');
    };

    api.read_text_file = async function(path) {
        try {
            var d = await http('GET', '/api/fs/read?path=' +
                encodeURIComponent(path || ''));
            return d.ok ? (d.content || '') : null;
        } catch (e) {
            return null; // 浏览器宿主读取失败时静默回落
        }
    };

    api.open_url = async function(url) {
        if (url) window.open(url, '_blank');
        return true;
    };

    api.quit_app = async function() {
        try { await http('POST', '/api/quit', {}); } catch (e) { /* 忽略 */ }
        return true;
    };

    api.log_frontend_error = function(msg) {
        try {
            fetch(API_BASE + '/api/log', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: String(msg || '') })
            }).catch(function() {});
        } catch (e) { /* 忽略 */ }
    };

    // ── 工作回退（快照 / Undo / Redo / Rollback） ─────────────
    api.list_snapshots = async function() {
        var d = await http('GET', '/api/snapshots');
        return d.items || [];
    };

    api.snapshot_action = async function(action, payload) {
        return await http('POST', '/api/snapshots', {
            action: action || '', payload: payload || {}
        });
    };

    window.pywebview = { api: api };
    // 宿主标记：浏览器（库化 Web 模式）为 'browser'；pywebview 桌面无此标记。
    // 页面据此隐藏桌面专属设置（移动端远程控制等），其余逻辑双宿主共享。
    window.NORP_HOST = 'browser';

    // ── 触发 pywebviewready ──────────────────────────────────
    // 必须等全部脚本（含 main.js 的监听注册）执行完毕。
    function _fireReady() {
        try { window.dispatchEvent(new Event('pywebviewready')); } catch (e) {}
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', _fireReady);
    } else {
        setTimeout(_fireReady, 0);
    }

    // ── SSE 连接（事件流转发到各会话队列） ────────────────────
    connectSSE();
})();

</script>
</body>
</html>
